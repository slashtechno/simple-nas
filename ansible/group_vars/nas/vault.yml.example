# Copy to vault.yml, fill in values, then encrypt:
#   ansible-vault encrypt group_vars/nas/vault.yml
#
# To edit later (opens in $EDITOR — set to VS Code with the line below):
#   EDITOR="code --wait" ansible-vault edit group_vars/nas/vault.yml

vault_immich_db_password: "change-me-generate-with-openssl-rand-base64-32"
vault_copyparty_user: "yourusername"
vault_copyparty_pass: "yourpassword"
# Friends who can access /collab via WebDAV:
vault_copyparty_collab_users:
  - user: "friend1"
    pass: "change-me-generate-with-openssl-rand-base64-32"
  - user: "friend2"
    pass: "change-me-generate-with-openssl-rand-base64-32"
# Only used if sftp_enabled is true (vars.yml) -- the scoped
# SFTP account for pocketpi's NAS sync, read/write on /files only:
vault_pocketpi_nas_user: "pocketpi"
vault_pocketpi_nas_pass: "change-me-generate-with-openssl-rand-base64-32"
# One per entry in copyparty_service_accounts (vars.yml):
vault_copyparty_photos_pass: "change-me-generate-with-openssl-rand-base64-32"
# Read-only token for cloning private GitHub repos onto the NAS (roles/common/tasks/clone_private_repo.yml).
# Create a fine-grained token at https://github.com/settings/personal-access-tokens/new: repository access
# "Only select repositories" (just the one you need), permission Contents: Read-only, and nothing else.
# It expires after at most a year; set a reminder to renew it.
vault_github_read_token: "github_pat_..."
# pics: the owner login (12+ characters) and the key that signs share links (openssl rand -base64 48).
vault_pics_password: "change-me-12-characters-minimum"
vault_pics_secret_key: "change-me-generate-with-openssl-rand-base64-48"
vault_pics_alert_urls: ""   # optional Apprise URLs, space-separated
vault_gitea_runner_token: ""   # optional; leave empty to skip runner
vault_cf_api_token: "your_cloudflare_api_token"
vault_cf_account_id: "your_cloudflare_account_id"
vault_garage_rpc_secret: "change-me-generate-with-openssl-rand-hex-32"
vault_garage_admin_token: "change-me-generate-with-openssl-rand-hex-32"
vault_garage_webui_user: "admin"
vault_garage_webui_pass: "change-me"
vault_restic_password: "change-me-generate-with-openssl-rand-base64-32"
# Generate at: https://login.tailscale.com/admin/settings/keys
# Do NOT tick "Ephemeral": ephemeral nodes are deleted from the tailnet 30-60 min after going
# offline (meant for CI/containers), so a power cut would cost the Pi its IP, name and Funnel URL.
# A plain one-off key is fine (it's only used for the first login; Tailscale keeps its own node
# key afterwards). After the first run, in the admin console open the Pi's menu -> "Disable key
# expiry", or its node key lapses after ~180 days. (Keys with a tag skip that step but need the
# tag in your ACL tagOwners and set `tailscale_tags` in vars.yml.)
# Re-provisioning / swapping the Pi? Mint a fresh key first; a used one-off key won't work again
# (or use a "Reusable" key, which expires within 90 days).
vault_tailscale_authkey: "tskey-auth-..."
