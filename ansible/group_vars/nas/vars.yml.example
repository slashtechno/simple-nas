# Copy to vars.yml and fill in your values.
# Secrets (passwords, tokens) go in vault.yml — never in this file.
# Versions, ports and other knobs private to one service default in roles/<name>/defaults/main.yml;
# set one here only to override it.

# --- Enable/disable services ---
# Set false to skip a service. To remove one already deployed: teardown.yml --tags <name>
storage_enabled: true   # set false if drives already mounted (e.g. migrating existing setup)
immich_enabled: true
copyparty_enabled: true
gitea_enabled: true
homebridge_enabled: true
cloudflared_enabled: true
pics_enabled: false   # photo culling and sharing; needs vault_github_read_token (see docs/services.md#pics-photo-culling-and-sharing)
garage_enabled: false   # needs manual init after first deploy (see docs/services.md#garage-s3)
crafty_enabled: false   # Minecraft server manager (Crafty Controller); needs RAM headroom, see docs/services.md#crafty-minecraft-servers
backup_enabled: true
backup_status_enabled: true   # read-only web dashboard for backup status/snapshots

# --- Tailscale ---
# Every service that publishes a host port is reachable at http://<host-tailscale-name>:<port> from
# any device on your tailnet. That needs nothing extra: no `tailscale serve`, no funnel. The funnel
# (roles/tailscale_funnel/defaults/main.yml) only gives Copyparty a public ts.net name; pics' guest
# pages go through the Cloudflare tunnel (a cloudflared_ingress entry that points at pics_public_port).

# --- Dump scripts ---
# One dump script per service with a live database (see docs/backups.md).
service_dump_scripts_dir: "{{ nas_scripts_dir }}/dump.d"

# --- Backups (docs/backups.md) ---
restic_repo_path: "{{ backup_drive }}/restic-repo"
# Offsite repository. The URL scheme picks the backend (docs/backups.md#offsite-repository-restic_cloud_repository):
# "rclone:gdrive-nas:/path" for Google Drive, "sftp:user@host:/path" for SFTP. The deploy fails if it cannot be initialised.
restic_cloud_repository: "rclone:gdrive-nas:/pi-nas-backups"
restic_password_file: "/home/{{ ansible_user }}/.restic-password"
backup_logs_dir: "{{ backup_drive }}/logs"
service_dumps_dir: "{{ backup_drive }}/service-dumps"
# What the local (daily) backup copies. The dumps dir above is always added by
# the backup script, so editing this list can't drop the database dumps.
# CAUTION: restic groups snapshots by host + paths, so changing this list
# starts a new snapshot group; the old group's last snapshots stay until you
# run `restic forget --path <old path> ...` by hand (see docs/plans/drive-migration.md).
# To skip something, add it to restic_local_excludes instead: excludes never split a group.
restic_local_paths: "{{ [main_drive, fast_drive] | unique }}"
# Extra patterns for the local backup to skip, added AFTER the defaults in
# roles/backup/templates/restic-excludes-local.txt.j2 (caches, lost+found, ...).
# restic syntax, not gitignore: `**` matches any depth, and a leading `!` re-includes
# something an earlier line excluded, e.g. ["{{ fast_drive }}/docker/crafty/logs", "!{{ fast_drive }}/docker/crafty/logs/keep.log"].
restic_local_excludes: []
# Extra paths for the cloud (weekly) backup, on top of the fixed ones in
# roles/backup/templates/backup-paths.txt.j2 (/opt/nas, rclone config, restic
# password file, Copyparty config). Each path is its own restic snapshot group.
# Adding a path is safe. Removing one leaves its old snapshots until you run
# `restic forget --path <path> ...` by hand. Examples:
#   - "{{ immich_upload_location }}"            # all photos
#   - "{{ crafty_data_dir }}"                   # Minecraft worlds (live copy; see docs/backups.md)
#   - "{{ copyparty_files_dir }}/documents"     # a single Copyparty folder
restic_cloud_extra_paths: []
# Same syntax; added after the defaults in restic-excludes-cloud.txt.j2.
restic_cloud_excludes: []
restic_local_retention: "--keep-daily 7 --keep-weekly 4 --keep-monthly 1"
restic_cloud_retention: "--keep-weekly 12 --keep-monthly 6"
# rclone's default Google Drive OAuth client is shared by every rclone user, so its request quota runs out
# during a burst of small-file uploads (seen: 403 RATE_LIMIT_EXCEEDED on the first cloud backup).
# The throttle works around it. Owner decision: no custom OAuth client; see docs/backups.md.
restic_cloud_rclone_args: "serve restic --stdio --tpslimit=10"
# Every restic invocation in the backup scripts is wrapped in `timeout` with
# this value. Without it, a stalled rclone/network pipe can deadlock restic
# indefinitely while holding the repo lock — seen in practice: a cloud backup
# hung for 6 days straight (2m of CPU time burned across the whole span),
# silently blocking every later cloud backup/prune behind its stale lock.
restic_command_timeout: "2h"

# restic's local index/snapshot cache lives on the fast drive — it keeps
# cache reads off the spinning backup drive and off Google Drive round-trips
# (this matters most for the rclone/gdrive repo; see restic's cache docs).
# Same-filesystem caching is near-pointless, so this only pays off once the
# cache drive differs from the repo drive. Excluded from backups.
restic_cache_dir: "{{ fast_drive }}/restic-cache"

# Service data split across drive roles: random-IO data (Docker, DBs,
# configs) on the fast drive; bulk data (photos, files) on the primary.
# When both roles resolve to the same drive, this changes nothing on disk.
immich_upload_location: "{{ main_drive }}/photos"
immich_db_data_location: "{{ fast_drive }}/docker/immich_postgres"
copyparty_files_dir: "{{ main_drive }}/files"
copyparty_config_dir: "{{ fast_drive }}/docker/copyparty_config"
copyparty_hist_dir: "{{ fast_drive }}/copyparty-hist"   # thumbnails/dbs/transcode cache (see copyparty role)
gitea_data_dir: "{{ fast_drive }}/docker/gitea"
gitea_runner_data_dir: "{{ fast_drive }}/docker/gitea_runner"   # runner registration (.runner); on the fast drive so it is backed up
pics_data_dir: "{{ fast_drive }}/docker/pics"
homebridge_config_dir: "{{ fast_drive }}/docker/homebridge"
garage_data_dir: "{{ fast_drive }}/docker/garage"
crafty_data_dir: "{{ fast_drive }}/docker/crafty"

# --- Drives ---
# Drives are the source of truth: every nas_drives entry declares which
# roles it fills via `roles:` (a list — one drive can hold several roles;
# a single-drive NAS is one entry with roles: [fast, primary, backup]).
# Allowed roles, exactly one claim each (validated by the storage role;
# unknown role names and double claims fail the deploy):
#   fast    — SSD; random-IO data (Docker, Immich DB, configs) + caches
#             (restic cache, copyparty hist/thumbnails)
#   primary — bulk data (photos, files)
#   backup  — restic local repo, service dumps, logs
# fast_drive, main_drive and backup_drive are worked out from these entries in derived.yml.
# The example below uses a 2-drive layout: fast and primary share one drive until more are added.
# fstab entries — idempotent, no-ops if drives already mounted.
# Find UUIDs on the Pi: lsblk -o NAME,SIZE,FSTYPE,UUID,MOUNTPOINTS
nas_drives:
  - uuid: "your-fast-drive-uuid"
    mount: /mnt/t7
    fstype: ext4
    options: defaults,nofail   # nofail = Pi still boots if drive is unplugged
    roles: [fast, primary]     # one drive doing both roles (2-drive setup)
  - uuid: "your-backup-drive-uuid"
    mount: /mnt/backup
    fstype: ext4
    options: defaults,nofail
    roles: [backup]
# 3-drive example (fast split onto its own SSD):
#   T7/SSD entry: roles: [fast]
#   large data drive /mnt/main: roles: [primary]
#   backup drive: roles: [backup]

# --- Copyparty ---
copyparty_user: "{{ vault_copyparty_user }}"
copyparty_pass: "{{ vault_copyparty_pass }}"
copyparty_collab_dir: "{{ main_drive }}/collab"   # shared directory for friends
copyparty_port: 3923

# Accounts for apps that talk to Copyparty. Each gets its own volume at
# /<folder>, stored in copyparty_files_dir/<folder>; the admin gets A on it
# too. Two entries can't share a folder. Passwords go in vault.yml.
copyparty_service_accounts:
  # Example: a photo app. No d on photos: without delete, Copyparty also refuses
  # overwrites (it renames instead), so the app can't destroy a photo. It may
  # delete only in its own photos-trash volume.
  - user: photos
    pass: "{{ vault_copyparty_photos_pass }}"
    volumes:
      - { folder: photos, perms: rwm }
      - { folder: photos-trash, perms: rwmd }

# --- Gitea ---
gitea_root_url: "https://gitea.example.com/"
gitea_domain: "gitea.example.com"
gitea_ssh_domain: "gitea.example.com"
gitea_ssh_port: "2222"

# --- pics ---
# Builds from a private repo with vault_github_read_token. It reaches Copyparty as the "photos" account
# above. The container publishes <pics_port> on the Pi, so the whole app (owner pages included) is on
# your LAN and tailnet with no `tailscale serve` needed. Only guest pages go public, through the
# cloudflared_ingress entry below, which points at pics_public_port.
pics_repo: owner/lab
pics_public_url: "https://photos.example.com"
pics_public_port: 8001   # container-internal (never published): the tunnel points here.
                         # Container ports can't collide with other services — separate namespaces.
                         # Only pics_port is published on the Pi (LAN + tailnet).
pics_artist: ""           # written into the EXIF of public downloads
pics_website: ""          # e.g. "example.com" — watermarked + linked from the home page
pics_instagram: ""        # e.g. "@you" — watermarked + linked from the home page

# --- Cloudflare Tunnel ---
cf_tunnel_name: pi-nas-tunnel
cf_api_token: "{{ vault_cf_api_token }}"
cf_account_id: "{{ vault_cf_account_id }}"
# Domain -> zone ID, for the DNS record of each cloudflared_ingress hostname (the domain that appears in the hostname).
# Zone IDs aren't secret. The API token needs DNS:Edit on each of these zones.
cf_zones:
  example.com: your_zone_id
  other-domain.example: your_other_zone_id

# One entry per public hostname, with exactly two keys: hostname, and service (the internal Docker
# address). No `path:`. The hostname must contain one domain from cf_zones above. Where a service
# has a private surface, it publishes two ports and the tunnel points at the guest one.
cloudflared_ingress:
  - hostname: immich.example.com
    service: "http://immich_server:2283"
  - hostname: gitea.example.com
    service: "http://gitea:3000"
  # pics' guest surface: share pages and the portfolio, with no owner routes in it. The owner app
  # stays on the Pi's LAN/tailnet port (pics_port); this file never forwards it.
  - hostname: photos.example.com
    service: "http://pics:{{ pics_public_port }}"
  - hostname: copyparty.example.com
    service: "http://copyparty:3923"
  - hostname: s3.example.com
    # Caddy CORS proxy sits on 3900; it handles OPTIONS preflights and injects
    # Access-Control-Allow-Origin before forwarding to Garage internally.
    service: "http://garage-cors-proxy:3900"
  - hostname: garage.example.com
    service: "http://garage-webui:3909"
