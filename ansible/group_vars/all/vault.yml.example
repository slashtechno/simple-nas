# Secrets every host uses. Copy to vault.yml, fill in, then encrypt:
#   ansible-vault encrypt --vault-password-file .vault-pass group_vars/all/vault.yml
# To edit later: ansible-vault edit --vault-password-file .vault-pass group_vars/all/vault.yml
# Secrets for one host go in host_vars/<host>/vault.yml (host_vars/vault.yml.example). Same password for all.
# A key defined in both files takes the host's value, so move a key here, do not copy it.

# Cloudflare API token with Zone:DNS:Edit on every zone in cloudflare_zones and Account:Cloudflare Tunnel:Edit.
# Caddy (caddy_private_domains) reads it too, and puts it in its compose file on the host.
vault_cloudflared_api_token: "your_cloudflare_api_token"
# ID of the Cloudflare account that owns the tunnel.
vault_cloudflared_account_id: "your_cloudflare_account_id"
# Login token for the ntfy server (roles/ntfy), used by the server and by every host that sends alerts.
# "tk_" and 29 letters or digits: `docker run --rm binwiederhier/ntfy token generate`.
vault_ntfy_token: "tk_changeMe0123456789abcdefghijk"
# Encrypts every restic repository the hosts write.
vault_restic_password: "change-me-generate-with-openssl-rand-base64-32"
# Google Drive login for the cloud backup: the JSON that `rclone authorize "drive" --drive-scope drive.file`
# prints on a computer with a browser (docs/backups.md). Optional: leave empty if rclone.conf is set up by hand.
vault_rclone_gdrive_token: ""
# Tinyauth users, "name:bcrypt-hash" separated by commas. Make one with
# `docker run -i -t --rm ghcr.io/tinyauthapp/tinyauth:v5 user create --interactive` (choose the format for Docker only if you
# paste it into a compose file yourself; the deploy escapes the dollar signs). Used with tinyauth_enabled. Here, in the shared vault, every host with Tinyauth accepts the same logins; to give one host its own users, put the same name in that host's vault.yml (the host's value wins).
vault_tinyauth_users: "you:$2a$10$changemechangemechangemechangemechangemechangemechangeme"
