---
# Your values for the settings that have no default or that nearly every owner changes. Copy to vars.yml.
# Everything else, with its default, is in defaults.yml and docs/variables.md; override a setting by writing it here.

timezone: America/New_York
# One public key per device that may log in as the Ansible user.
ssh_authorized_keys:
  - ssh-ed25519 AAAA... you@laptop
# Domain -> Cloudflare zone ID, for hosts that run a tunnel (cloudflared_enabled).
cloudflared_zones:
  example.com: your_zone_id
# Gitea (gitea_enabled): its public URL, host name and SSH host name.
gitea_root_url: "https://gitea.example.com/"
gitea_domain: "gitea.example.com"
gitea_ssh_domain: "gitea.example.com"
# pics (pics_enabled): the private GitHub repo it builds from and its public guest URL.
pics_repo: owner/lab
pics_public_url: "https://photos.example.com"
