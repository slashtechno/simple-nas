# Settings every server reads, whatever its function. Copy to vars.yml and fill in your values.
# Secrets go in a vault.yml next to this file, never here.

# Timezone for the host and its containers. List names with `timedatectl list-timezones`.
timezone: America/New_York
# Where compose projects and helper scripts are deployed on the host.
nas_base_dir: /opt/nas
nas_scripts_dir: "{{ nas_base_dir }}/scripts"
# --- Which services run on a host ---
# Every service is off until a group or host switches it on: set `<name>_enabled: true` in
# group_vars/<group>/vars.yml or host_vars/<host>/vars.yml, and false again to stop deploying it.
# A service that is already deployed keeps running; remove it with teardown.yml --tags <name>.
# What each service needs (drive roles, vault entries) is in docs/services.md.
immich_enabled: false
copyparty_enabled: false
gitea_enabled: false
homebridge_enabled: false
pics_enabled: false
garage_enabled: false
crafty_enabled: false
ntfy_enabled: false
cloudflared_enabled: false
dockge_enabled: false
caddy_enabled: false
backup_enabled: false
backup_status_enabled: false

# Mount drives through fstab (the storage role). Set false on a host whose drives are already mounted.
storage_enabled: true
# This host's drives. Empty by default; a host that has drives lists them in host_vars/<host>/vars.yml
# (explained in host_vars/vars.yml.example).
drives: []
# Mount USB drives and card readers when they are plugged in (not drives listed in `drives`).
# Mounted at /run/media/system/<label>; Copyparty shows them under /drives (docs/storage.md).
usb_automount_enabled: false
# false: plugged-in drives are read-only. true: Copyparty can change and delete files on them.
usb_automount_writable: false
# Name of the shared Docker network the services join.
nas_network: nas-services
# Docker image pull policy. Allowed: missing, always. Default: missing.
# "always" pulls newer images on every run, see ansible/README.md#update-service-images.
docker_pull_policy: missing
# Log rotation for every container: json-file keeps 3 files of 10m per container. Docker's default
# never rotates, and logs on a microSD card fill it. Allowed: json-file options (strings).
# CAUTION: applies only to containers created after the change; recreate the rest with
# `docker compose up -d --force-recreate` in each project.
docker_log_opts:
  max-size: "10m"
  max-file: "3"

# Where Docker and containerd keep images, layers and anonymous volumes. Empty keeps their default
# (/var/lib/docker and /var/lib/containerd, on the microSD card). Set it per host in
# host_vars/<host>/vars.yml to a directory on a mounted drive, e.g. "/mnt/t7/docker-root".
# Docker is held back until that drive is mounted (systemd RequiresMountsFor), so it cannot
# fill the microSD under an empty mount point. The procedure and tests: docs/storage.md.
# CAUTION: changing it hides existing images and containers until they are pulled/created again.
docker_data_root: ""

# SSH public keys allowed to log in as the Ansible user, one per device. Added, never removed:
# a key you delete here stays on the hosts until removed from ~/.ssh/authorized_keys by hand.
ssh_authorized_keys:
  - ssh-ed25519 AAAA... you@laptop

# --- Backups (docs/backups.md) ---
# The backup role runs on a host with `backup_enabled: true` (set per group or host). A drive with the
# `backup` role adds the daily local backup and the weekly integrity check. Setting `restic_cloud_repository`
# below adds the weekly offsite copy. A host needs at least one of the two.
# Without a backup drive, logs and service dumps live in /var/lib/nas-backup on the root drive.
# One dump script per service with a live database.
service_dump_scripts_dir: "{{ nas_scripts_dir }}/dump.d"
# Local repository; used only when a backup drive is claimed.
restic_repo_path: "{{ backup_drive }}/restic-repo"
# Offsite repository. The URL scheme picks the backend (docs/backups.md#offsite-repository-restic_cloud_repository):
# "rclone:gdrive-nas:/path" for Google Drive, "sftp:user@host:/path" for SFTP. The deploy fails if it cannot be
# initialised. Set it per host in host_vars (each host needs its own path: hosts sharing a repository would
# prune each other's snapshots). Empty means no offsite copy.
restic_cloud_repository: ""
restic_password_file: "/home/{{ ansible_user }}/.restic-password"
backup_logs_dir: "{{ backup_work_dir }}/logs"
service_dumps_dir: "{{ backup_work_dir }}/service-dumps"
# What the local (daily) backup copies. The dumps dir above is always added by
# the backup script, so editing this list can't drop the database dumps.
# Default: the primary and fast drives; a host with neither role backs up the user's home. The backup runs as
# the ansible user, so files only root can read (/etc, container-owned data) are skipped: restic reports
# "unreadable source files" in the log and the run still counts as done.
# CAUTION: restic groups snapshots by host + paths, so changing this list
# starts a new snapshot group; the old group's last snapshots stay until you
# run `restic forget --path <old path> ...` by hand (see docs/plans/drive-migration.md).
# To skip something, add it to restic_local_excludes instead: excludes never split a group.
restic_local_paths: "{{ [drive_mounts.primary | default(''), drive_mounts.fast | default('')] | select | unique | list or ['/home/' ~ ansible_user] }}"
# Extra patterns for the local backup to skip, added AFTER the defaults in
# roles/backup/templates/restic-excludes-local.txt.j2 (caches, lost+found, ...).
# restic syntax, not gitignore: `**` matches any depth, and a leading `!` re-includes
# something an earlier line excluded, e.g. ["/mnt/t7/docker/crafty/logs", "!/mnt/t7/docker/crafty/logs/keep.log"].
restic_local_excludes: []
# Extra paths for the cloud (weekly) backup, on top of the fixed ones in
# roles/backup/templates/backup-paths.txt.j2 (the scripts dir, rclone config and restic password file;
# on the NAS also Copyparty's config). Each path is its own restic snapshot group.
# Adding a path is safe. Removing one leaves its old snapshots until you run
# `restic forget --path <path> ...` by hand. Examples (NAS):
#   - "{{ immich_upload_location }}"            # all photos
#   - "{{ crafty_data_dir }}"                   # Minecraft worlds (live copy; see docs/backups.md)
#   - "{{ copyparty_files_dir }}/documents"     # a single Copyparty folder
restic_cloud_extra_paths: []
# Same syntax; added after the defaults in restic-excludes-cloud.txt.j2.
restic_cloud_excludes: []
restic_local_retention: "--keep-daily 7 --keep-weekly 4 --keep-monthly 1"
restic_cloud_retention: "--keep-weekly 12 --keep-monthly 6"
# rclone's default Google Drive client is shared by all rclone users, so a burst of small uploads can
# fail with 403 RATE_LIMIT_EXCEEDED. This throttle avoids that; no custom OAuth client (docs/backups.md).
restic_cloud_rclone_args: "serve restic --stdio --tpslimit=10"
# Every restic call in the backup scripts is wrapped in `timeout` with this value, so a stalled
# rclone or network pipe cannot hold the repo lock indefinitely.
restic_command_timeout: "2h"
# restic's index and snapshot cache. On the fast drive it keeps cache reads off the backup drive and
# off Google Drive; it only helps once the fast and backup roles are different drives. Not backed up.
# A host without a fast drive keeps it in the user's ~/.cache.
restic_cache_dir: "{{ drive_mounts.fast ~ '/restic-cache' if 'fast' in drive_mounts else '/home/' ~ ansible_user ~ '/.cache/restic' }}"

# --- Data directories (teardown.yml also reads them) ---
# One variable per service. To move a service to another drive, set its variable in host_vars/<host>/vars.yml
# (procedure: docs/storage.md#move-one-services-data). Keep the new path under a drive that has a role, or the
# default backup (restic_local_paths) does not cover it. A variable that uses a drive role fails with a
# message naming the role if no entry in `drives` claims it, but only on a host that enables the service.
# Random-IO data (databases, configs) is on the fast drive; bulk data (photos, files) is on the primary.
# When both roles are the same drive, the split changes nothing on disk.
# The compose stacks you create in Dockge: one directory each, holding a compose.yaml and its data.
dockge_stacks_dir: "{{ fast_drive }}/stacks"
# Dockge's own database (users, settings).
dockge_data_dir: "{{ fast_drive }}/docker/dockge"
# Caddy's certificates and state. Losing it means certificates are issued again.
caddy_data_dir: "{{ fast_drive }}/docker/caddy"

# --- Failure alerts (roles/backup/templates/alert.sh.j2) ---
# A failed backup job always goes to the system log (`journalctl -t nas-backup`). Set this to also send it
# to an ntfy server's topic, e.g. "http://localhost:8090/alerts" on the NAS (roles/ntfy). The login token
# is vault_ntfy_token. Leave "" to send nothing. A host that is down or unreachable cannot alert.
ntfy_alert_url: ""
ntfy_token_file: "{{ nas_base_dir }}/ntfy-token"

# --- Cloudflare Tunnel (roles/cloudflared; a server that runs one sets cloudflared_enabled: true and its own cloudflared_ingress) ---
cf_api_token: "{{ vault_cf_api_token }}"
cf_account_id: "{{ vault_cf_account_id }}"
# Domain -> zone ID, for the DNS record of each cloudflared_ingress hostname (the domain that appears in the hostname).
# Zone IDs aren't secret. The API token needs DNS:Edit on each of these zones.
cf_zones:
  example.com: your_zone_id
  other-domain.example: your_other_zone_id
# Public hostnames this host's tunnel serves. Empty here; the NAS group lists its own (group_vars/nas/vars.yml).
# One entry per hostname, exactly two keys: hostname and service (the internal Docker address). No `path:`.
# The hostname must contain one domain from cf_zones. A hostname may appear on only one host; the deploy fails otherwise.
cloudflared_ingress: []

# --- Tailscale ---
# Every service that publishes a host port is reachable at http://<host-tailscale-name>:<port> from
# any device on your tailnet. That needs nothing extra: no `tailscale serve`, no funnel. The funnel
# (roles/tailscale_funnel/defaults/main.yml) only gives Copyparty a public ts.net name; pics' guest
# pages go through the Cloudflare tunnel (a cloudflared_ingress entry that points at pics_public_port).

# Service data split across drive roles: random-IO data (Docker, DBs,
# configs) on the fast drive; bulk data (photos, files) on the primary.
# When both roles resolve to the same drive, this changes nothing on disk.
immich_upload_location: "{{ primary_drive }}/photos"
immich_db_data_location: "{{ fast_drive }}/docker/immich_postgres"
copyparty_files_dir: "{{ primary_drive }}/files"
copyparty_config_dir: "{{ fast_drive }}/docker/copyparty_config"
copyparty_hist_dir: "{{ fast_drive }}/copyparty-hist"   # thumbnails/dbs/transcode cache (see copyparty role)
gitea_data_dir: "{{ fast_drive }}/docker/gitea"
gitea_runner_data_dir: "{{ fast_drive }}/docker/gitea_runner"   # runner registration (.runner); on the fast drive so it is backed up
ntfy_data_dir: "{{ fast_drive }}/docker/ntfy"   # message history and the user database; rebuilt from the compose file, so little is lost without it
pics_data_dir: "{{ fast_drive }}/docker/pics"
homebridge_config_dir: "{{ fast_drive }}/docker/homebridge"
garage_data_dir: "{{ fast_drive }}/docker/garage"
crafty_data_dir: "{{ fast_drive }}/docker/crafty"

# --- Copyparty ---
copyparty_user: "{{ vault_copyparty_user }}"
copyparty_pass: "{{ vault_copyparty_pass }}"
copyparty_collab_dir: "{{ primary_drive }}/collab"   # shared directory for friends
copyparty_port: 3923

# Accounts for apps that talk to Copyparty. Each gets its own volume at
# /<folder>, stored in copyparty_files_dir/<folder>; the admin gets A on it
# too. Two entries can't share a folder. Passwords go in vault.yml.
copyparty_service_accounts:
  # Example: a photo app. No d on photos: without delete, Copyparty also refuses
  # overwrites (it renames instead), so the app can't destroy a photo. It may
  # delete only in its own photos-trash volume.
  - user: photos
    pass: "{{ vault_copyparty_photos_pass }}"
    volumes:
      - { folder: photos, perms: rwm }
      - { folder: photos-trash, perms: rwmd }

# --- Gitea ---
gitea_root_url: "https://gitea.example.com/"
gitea_domain: "gitea.example.com"
gitea_ssh_domain: "gitea.example.com"
gitea_ssh_port: "2222"

# --- pics ---
# Builds from a private repo with vault_github_read_token. It reaches Copyparty as the "photos" account
# above. The container publishes <pics_port> on the Pi, so the whole app (owner pages included) is on
# your LAN and tailnet with no `tailscale serve` needed. Only guest pages go public, through the
# cloudflared_ingress entry below, which points at pics_public_port.
pics_repo: owner/lab
pics_public_url: "https://photos.example.com"
pics_public_port: 8001   # container-internal (never published): the tunnel points here.
                         # Container ports can't collide with other services — separate namespaces.
                         # Only pics_port is published on the Pi (LAN + tailnet).
pics_artist: ""           # written into the EXIF of public downloads
pics_website: ""          # e.g. "example.com" — watermarked + linked from the home page
pics_instagram: ""        # e.g. "@you" — watermarked + linked from the home page
