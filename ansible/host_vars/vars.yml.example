# Copy to host_vars/<host>/vars.yml, named after the host in the inventory, and keep only the
# options this host needs. Secrets for one host (a wifi password) go in host_vars/<host>/vault.yml.

# Direct Ethernet link, a cable from the Pi to a laptop (explained in group_vars/all/defaults.yml).
# direct_link_enabled: true   # the address and port settings, with defaults, are in group_vars/all/defaults.yml

# Services: turn one on for this host with `<name>_enabled: true` (the flags are listed in
# group_vars/all/defaults.yml, what each needs in docs/services.md). Flags are set per host, here.

# --- Drives ---
# Drives are listed per host. Each entry is mounted through fstab and says which roles it fills with
# `roles:` (a list: one drive can fill several roles, or none). A host with no drives leaves the
# list out; its default is [] (group_vars/all/defaults.yml).
# The roles (fast, primary, backup), what an unclaimed one does, UUIDs and the one-, two- and three-drive examples:
# docs/storage.md.
# drives:
#   - { uuid: "...", mount: /mnt/data, roles: [fast, primary] }

# --- Encryption ---
# Folders stored encrypted with gocryptfs; unlock by hand after each boot (docs/encryption.md).
# encrypted_folders:
#   - /mnt/data/photos

# --- Offsite backup ---
# backup_cloud_enabled turns on the weekly offsite copy for this host. It uploads only the base directory and
# Copyparty's config; add data paths to restic_cloud_extra_rules (docs/backups.md). Every host needs its own
# path: hosts sharing a repository would prune each other's snapshots. Backends and setup: docs/backups.md.
# backup_cloud_enabled: true
# restic_cloud_repository: "rclone:gdrive:/<host>-backups"

# --- Cloudflare Tunnel ---
# Public hostnames this host's tunnel serves (cloudflared_enabled; docs/services.md#cloudflare-add-a-public-hostname).
# Exactly two keys per entry, no `path:`.
# cloudflared_ingress:
#   - hostname: newservice.example.com
#     service: "http://newservice:8080"
