# Copy to host_vars/<host>/vars.yml, named after the host in the inventory, and keep only the
# options this host needs. Secrets for one host (a wifi password) go in host_vars/<host>/vault.yml.

# Direct Ethernet link (Pi <-> laptop, bypasses wifi for fast transfers)
# Plug a cable straight from the Pi's eth0 into a laptop. Static IP, no gateway,
# so it can't route internet traffic. Laptop's IP is auto-assigned via a
# scoped dnsmasq (DHCP only, no DNS/gateway) — no manual laptop config needed.
# See docs/networking.md#direct-ethernet-link.
direct_link_enabled: false
direct_link_iface: eth0
direct_link_ip: 10.10.20.1        # Pi's address on the link
direct_link_peer_ip: 10.10.20.2   # handed to the laptop automatically via dnsmasq
direct_link_prefix: 30            # /30 = just these two addresses, nothing else fits

# Ad-hoc app platform (general servers only; see docs/services.md#ad-hoc-app-platform).
# Dockge: web UI for compose stacks in dockge_stacks_dir. Default: true.
# Caddy: reverse proxy that names apps from container labels. Default: false.
dockge_enabled: true
caddy_enabled: false

# --- Drives ---
# Drives are listed per host. Each entry is mounted through fstab and says which roles it fills with
# `roles:` (a list: one drive can fill several roles, or none). A host with no drives leaves the
# list out; its default is [] (group_vars/all/vars.yml).
#   fast    SSD; random-IO data (Docker, Immich database, configs) and caches
#   primary bulk data (photos, files)
#   backup  restic local repo, service dumps, logs
# Each role may be claimed by at most one drive. On a NAS (the `nas` group) all three must be
# claimed; on a general server any of them may be left out. A drive with no `roles:` is only mounted.
# Find UUIDs on the host: lsblk -o NAME,SIZE,FSTYPE,UUID,MOUNTPOINTS
# `nofail` lets the host boot when a drive is unplugged. Docs: docs/storage.md (examples for 1-3 drives).
#
# NAS with two drives (fast and primary share the SSD):
#   drives:
#     - { uuid: "your-ssd-uuid",    mount: /mnt/t7,     fstype: ext4, options: "defaults,nofail", roles: [fast, primary] }
#     - { uuid: "your-backup-uuid", mount: /mnt/backup, fstype: ext4, options: "defaults,nofail", roles: [backup] }
# NAS with three drives: the same, with the SSD as roles: [fast] and a third entry mounted at
# /mnt/main with roles: [primary].
# General server: microSD plus one USB drive used for backups:
#   drives:
#     - { uuid: "your-usb-uuid", mount: /mnt/usb, fstype: ext4, options: "defaults,nofail", roles: [backup] }
# A drive that is only mounted (for Docker's data root, or a manual rsync target): leave out roles.
drives: []
