# Copy to host_vars/<host>/vars.yml, named after the host in the inventory, and keep only the
# options this host needs. Secrets for one host (a wifi password) go in host_vars/<host>/vault.yml.

# Direct Ethernet link (Pi <-> laptop, bypasses wifi for fast transfers)
# Plug a cable straight from the Pi's eth0 into a laptop. Static IP, no gateway,
# so it can't route internet traffic. Laptop's IP is auto-assigned via a
# scoped dnsmasq (DHCP only, no DNS/gateway) — no manual laptop config needed.
# See docs/networking.md#direct-ethernet-link.
direct_link_enabled: false   # the address and port settings, with defaults, are in group_vars/all/defaults.yml

# Services: turn one on for this host with `<name>_enabled: true` (the flags are listed in
# group_vars/all/defaults.yml, what each needs in docs/services.md). Flags are set per host, here.

# --- Drives ---
# Drives are listed per host. Each entry is mounted through fstab and says which roles it fills with
# `roles:` (a list: one drive can fill several roles, or none). A host with no drives leaves the
# list out; its default is [] (group_vars/all/defaults.yml).
#   fast    SSD; random-IO data (Docker, Immich database, configs) and caches
#   primary bulk data (photos, files)
#   backup  restic local repo, service dumps, logs
# Each role may be claimed by at most one drive. A host needs a drive for every role its enabled services
# use: an unclaimed role fails the deploy with a message naming it. No `backup` drive means no local backup.
# A drive with no `roles:` is only mounted.
# Find UUIDs on the host: lsblk -o NAME,SIZE,FSTYPE,UUID,MOUNTPOINTS
# Examples for one, two and three drives, and the `nofail` option: docs/storage.md#examples
drives: []

# --- Offsite backup ---
# backup_cloud_enabled turns on the weekly offsite copy for this host. It uploads only the base directory and
# Copyparty's config; add data paths to restic_cloud_rules (docs/backups.md). Every host needs its own
# path: hosts sharing a repository would prune each other's snapshots. Backends and setup: docs/backups.md.
backup_cloud_enabled: false
restic_cloud_repository: ""   # e.g. "rclone:gdrive:/<host>-backups"
