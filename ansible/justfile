# Common commands. Run `just` to list them. Install: brew install just
# (or run any recipe without installing: uvx --from rust-just just <recipe>)

# Lint tool versions. A new release can fail `just check` with no change in this repo, so they are pinned; raise them on purpose.
ansible_lint := "ansible-lint==26.10.1"
shellcheck := "shellcheck-py==0.11.0.1"
ruff := "ruff==0.17.3"

default:
    @just --list

# Install the Ansible collections and roles this repo needs
deps:
    ansible-galaxy collection install -r requirements.yml
    ansible-galaxy role install -r requirements.yml

# (Steps of `check`; private, run one with e.g. `just _lint`.)
# Style and bug checks: ansible-lint, shellcheck on shipped scripts, ruff on the shipped Python
_lint:
    uvx {{ ansible_lint }}
    uvx --from {{ shellcheck }} shellcheck --severity=warning roles/*/files/*.sh
    uvx {{ ruff }} check --isolated --select F,B roles/backup_status/files roles/dockge/files

# Both playbooks parse
_syntax:
    ansible-playbook --syntax-check site.yml teardown.yml

# Render every template with the example vars, then shellcheck the rendered scripts
_test:
    #!/usr/bin/env bash
    set -euo pipefail
    out="$(mktemp -d)"
    python3 -I tests/test_backup_status.py
    ansible-playbook -i tests/inventory.yml tests/render.yml -e "out_dir=$out"
    find "$out" -name '*.sh' -print0 | xargs -0 uvx --from {{ shellcheck }} shellcheck --severity=warning
    echo "Rendered templates are in $out"

# Fail if a vault name or a setting with no default is missing from its example file
_vars:
    python3 tools/check_vars.py

# Fail if a `file.md#anchor` reference names a heading that does not exist
_links:
    python3 tools/check_links.py

# Check that every pinned image has arm64 and x64 builds (needs docker and network; not part of `check`)
platforms:
    python3 tools/check_platforms.py

# Everything CI runs. Run this before committing.
check: _lint _syntax _vars _links _test

# Deploy everything, or one service: `just deploy crafty`. Extra flags go after: `just deploy '' --limit pinas -K`
deploy tags='' *flags:
    ansible-playbook site.yml --vault-password-file .vault-pass {{ if tags == '' { '' } else { '--tags ' + tags } }} {{ flags }}

# Remove services from a host (teardown.yml refuses to run without a host): `just teardown pi4 -e only=garage`
teardown host *flags:
    ansible-playbook teardown.yml --limit {{ host }} --vault-password-file .vault-pass {{ flags }}

# apt upgrade on every server, or one: `just os-upgrade pinas`. Reboot afterwards if the kernel or firmware changed.
os-upgrade limit='servers' *flags:
    ansible {{ limit }} --vault-password-file .vault-pass --become -m ansible.builtin.apt -a "update_cache=yes upgrade=safe" {{ flags }}

# First-run setup for a host: .vault-pass, host_vars/<host>/vars.yml, random vault secrets. Safe to rerun.
setup host:
    python3 tools/setup.py {{ host }}

# Preview a deploy without changing anything. Takes the same arguments as deploy.
preview tags='' *flags:
    ansible-playbook site.yml --check --diff --vault-password-file .vault-pass {{ if tags == '' { '' } else { '--tags ' + tags } }} {{ flags }}
