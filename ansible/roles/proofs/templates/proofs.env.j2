# Single quotes stop docker compose from interpolating "$" in a value
COPYPARTY_URL='http://copyparty:3923'
COPYPARTY_PASSWORD='{{ vault_copyparty_photos_pass }}'
HUB_PASSWORD='{{ vault_proofs_password }}'
HUB_SECRET_KEY='{{ vault_proofs_secret_key }}'
HUB_PUBLIC_URL='{{ proofs_public_url }}'
{% if proofs_artist %}
HUB_ARTIST='{{ proofs_artist }}'
{% endif %}
{% if proofs_watermark_text %}
HUB_WATERMARK_TEXT='{{ proofs_watermark_text }}'
{% endif %}
{% if vault_proofs_alert_urls | default('') %}
HUB_ALERT_URLS='{{ vault_proofs_alert_urls }}'
{% endif %}
