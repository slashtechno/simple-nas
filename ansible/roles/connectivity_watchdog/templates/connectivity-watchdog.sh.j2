#!/bin/bash
# Run by cron every 2 minutes as root (roles/connectivity_watchdog). A connected network port can have a valid
# address and answer ping while TCP stops working. Nothing reports that, so this checks it: connect to port 443 on
# a few IP addresses. After 3 failures in a row it reconnects the connection that carries the default
# route, at most once per 30 minutes and 6 times per outage. It never reboots. When the check works again
# after an outage it sends one alert. Every step is in the system log: journalctl -t connectivity
PATH=/usr/sbin:/usr/bin:/sbin:/bin

# Counters live in /run, which is empty after a reboot.
state=/run/connectivity-watchdog
mkdir -p "$state"
fails=$(cat "$state/fails" 2>/dev/null || echo 0)
reconnects=$(cat "$state/reconnects" 2>/dev/null || echo 0)
last_reconnect=$(cat "$state/last_reconnect" 2>/dev/null || echo 0)

online=false
for address in {{ connectivity_probe_addresses | map('quote') | join(' ') }}; do
  if timeout 5 bash -c 'exec 3<>/dev/tcp/$0/443' "$address" 2>/dev/null; then
    online=true
    break
  fi
done

if $online; then
  if [ "$fails" -ge 3 ]; then
    {{ (scripts_dir ~ '/alert.sh') | quote }} "Back online after $fails failed checks and $reconnects reconnects." connectivity "connectivity restored"
  fi
  rm -rf "$state"
  exit 0
fi

fails=$((fails + 1))
echo "$fails" > "$state/fails"
logger -t connectivity "No TCP connection to any probe address (check $fails in a row)"
[ "$fails" -ge 3 ] || exit 0

now=$(date +%s)
if [ "$reconnects" -ge 6 ] || [ $((now - last_reconnect)) -lt $((30 * 60)) ]; then
  exit 0
fi

# Hosts without NetworkManager only log.
if ! command -v nmcli > /dev/null; then
  logger -t connectivity "NetworkManager is not installed, so there is nothing to reconnect"
  exit 0
fi
interface=$(ip route show default | awk '{for (i = 1; i < NF; i++) if ($i == "dev") {print $(i + 1); exit}}')
connection=$(nmcli --get-values GENERAL.CONNECTION device show "$interface" 2>/dev/null)
if [ -z "$interface" ] || [ -z "$connection" ]; then
  logger -t connectivity "No NetworkManager connection carries the default route, so there is nothing to reconnect"
  exit 0
fi

echo "$((reconnects + 1))" > "$state/reconnects"
echo "$now" > "$state/last_reconnect"
logger -t connectivity "Reconnecting $connection on $interface"
nmcli connection down "$connection"
nmcli connection up "$connection"
