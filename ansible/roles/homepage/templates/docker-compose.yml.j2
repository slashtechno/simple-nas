# Ansible-managed — do not edit directly, edit the homepage_* settings and re-deploy.
networks:
  {{ docker_network }}:
    external: true

services:
  homepage:
    image: {{ homepage_image }}
    container_name: homepage
    restart: unless-stopped
    ports:
      - "{{ homepage_port }}:3000"
    volumes:
      - {{ services_dir }}/homepage/config:/app/config
    environment:
      # Homepage answers only on the exact Host header a request names; anything else gets a 400. The bare
      # name is what a browser sends when the page is served on port 443 (tailscale_serve_port).
      HOMEPAGE_ALLOWED_HOSTS: "{{ homepage_host }}:{{ homepage_port }},{{ inventory_hostname }}:{{ homepage_port }},{{ homepage_host }}"
    networks:
      - {{ docker_network }}
