# Ansible-managed — do not edit directly, edit the homepage_* settings and re-deploy.
networks:
  {{ docker_network }}:
    external: true

services:
  homepage:
    image: {{ homepage_image }}
    container_name: homepage
    restart: unless-stopped
{% if homepage_port != '' %}
    ports:
      - "{{ homepage_port }}:3000"
{% endif %}
    volumes:
      - {{ services_dir }}/homepage/config:/app/config
    environment:
      # Homepage answers only on the exact Host header a request names; anything else gets a 400. The bare
      # name is what a browser sends on port 443, as through Caddy; the Caddy name is first.
{% set caddy_names = caddy_private_domains | map('regex_replace', '^', homepage_subdomain ~ '.') | list if caddy_enabled | bool and homepage_subdomain != '' else [] %}
{% set port_names = [homepage_host ~ ':' ~ homepage_port, inventory_hostname ~ ':' ~ homepage_port, (ansible_host | default(inventory_hostname)) ~ ':' ~ homepage_port] if homepage_port != '' else [] %}
{% set allowed_hosts = (caddy_names + port_names + [homepage_host]) | unique %}
      HOMEPAGE_ALLOWED_HOSTS: "{{ allowed_hosts | join(',') }}"
    networks:
      - {{ docker_network }}
