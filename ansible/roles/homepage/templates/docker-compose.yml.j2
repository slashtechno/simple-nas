# Ansible-managed — do not edit directly, edit the homepage_* settings and re-deploy.
networks:
  {{ docker_network }}:
    external: true

services:
  homepage:
    image: {{ homepage_image }}
    container_name: homepage
    restart: unless-stopped
    ports:
      - "{{ homepage_port }}:3000"
    volumes:
      - {{ services_dir }}/homepage/config:/app/config
    environment:
      # Homepage answers only on the exact host:port a request names; anything else gets a 400.
      HOMEPAGE_ALLOWED_HOSTS: "{{ [homepage_host, inventory_hostname] | unique | map('regex_replace', '$', ':' ~ homepage_port) | join(',') }}"
    networks:
      - {{ docker_network }}
