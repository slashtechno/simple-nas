# Ansible-managed — do not edit directly. No theme or color is set, so the footer toggle works; custom.css
# gives both modes the Catppuccin colours.
title: {{ inventory_hostname | to_json }}
disableUpdateCheck: true
layout:
{% for host in groups['servers'] + ['Links'] %}
  {{ host | to_json }}:
    style: row
    columns: 3
{% endfor %}
