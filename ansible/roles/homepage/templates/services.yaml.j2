# Ansible-managed — do not edit directly. One group per host in the inventory, with a tile per enabled service
# (homepage_tiles, roles/homepage/vars/main.yml) and per homepage_extra_tiles of that host, then homepage_links.
# Values go through to_json so a colon or quote in a name or description stays valid YAML.
{% macro tile_entry(tile, host) %}
{% set port = tile.port if tile.port is defined else hostvars[host][tile.port_setting] %}
{% set href = (tile.scheme | default('http')) ~ '://' ~ hostvars[host].ansible_host | default(host) ~ ':' ~ port %}
    - {{ tile.name | to_json }}:
        href: {{ href | to_json }}
        description: {{ tile.description | to_json }}
        icon: {{ tile.icon | to_json }}
{% if tile.monitor | default(true) %}
        siteMonitor: {{ href | to_json }}
{% endif %}
{% endmacro %}
{% for host in groups['servers'] %}
{% set flags = homepage_tiles | map(attribute='flag') | map('extract', hostvars[host]) | map('bool') | list %}
{% set service_tiles = homepage_tiles | zip(flags) | selectattr('1') | map(attribute='0') | list %}
{% if service_tiles | length > 0 or hostvars[host].homepage_extra_tiles | length > 0 %}
- {{ host }}:
{% for tile in service_tiles %}
{{ tile_entry(tile, host) }}{% endfor %}
{% for tile in hostvars[host].homepage_extra_tiles %}
{{ tile_entry(tile, host) }}{% endfor %}
{% endif %}
{% endfor %}
{% if homepage_links | length > 0 %}
- Links:
{% for link in homepage_links %}
    - {{ link.name | to_json }}:
        href: {{ link.href | to_json }}
{% if link.description is defined %}
        description: {{ link.description | to_json }}
{% endif %}
{% endfor %}
{% endif %}
