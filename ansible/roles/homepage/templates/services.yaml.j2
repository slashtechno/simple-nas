# Ansible-managed — do not edit directly. The tiles come from homepage_tiles (roles/homepage/vars/main.yml),
# then homepage_links. Values go through to_json so a colon or quote in a name or description stays valid YAML.
{% set tiles = homepage_tiles | selectattr('enabled') | list %}
{% if tiles | length > 0 %}
- Services:
{% for tile in tiles %}
    - {{ tile.name | to_json }}:
        href: {{ tile.href | to_json }}
        description: {{ tile.description | to_json }}
{% endfor %}
{% endif %}
{% if homepage_links | length > 0 %}
- Links:
{% for link in homepage_links %}
    - {{ link.name | to_json }}:
        href: {{ link.href | to_json }}
{% if link.description is defined %}
        description: {{ link.description | to_json }}
{% endif %}
{% endfor %}
{% endif %}
{% if tiles | length == 0 and homepage_links | length == 0 %}
[]
{% endif %}
