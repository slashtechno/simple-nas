# Ansible-managed — do not edit directly. One group per host in the inventory, with a tile per enabled service
# (web_services in derived.yml, from the entries in services.yml), then homepage_links. Values go through to_json so a colon or
# quote in a name or description stays valid YAML.
{% for host in groups['servers'] %}
{% set domains = hostvars[host].caddy_private_domains %}
{% set has_names = hostvars[host].caddy_enabled | bool and domains | length > 0 %}
{# A tile needs a link: a Caddy name or a host port. #}
{% for tile in web_services if hostvars[host][tile.key ~ '_enabled'] | bool
     and (tile.port is defined or hostvars[host][tile.key ~ '_port'] | default('') != '' or (has_names and hostvars[host][tile.key ~ '_subdomain'] != '')) %}
{# The heading is printed once per host, before its first tile (loop.first). #}
{% if loop.first %}
- {{ host }}:
{% endif %}
{% set sub = hostvars[host][tile.key ~ '_subdomain'] if tile.port is not defined else '' %}
{# A service with a name under the host's private domain links to that name (HTTPS on port 443), or to the address its tile_url setting holds (services.yml); otherwise to host:port. #}
{% if has_names and sub != '' %}
{% set href = (hostvars[host][tile.tile_url] | regex_replace('/$', '')) if tile.tile_url is defined else 'https://' ~ sub ~ '.' ~ domains[0] %}
{% else %}
{% set port = tile.port if tile.port is defined else hostvars[host][tile.key ~ '_port'] | default('') %}
{% set href = (tile.scheme | default('http')) ~ '://' ~ hostvars[host].ansible_host | default(host) ~ ':' ~ port %}
{% endif %}
    - {{ tile.name | to_json }}:
        href: {{ href | to_json }}
        description: {{ tile.description | to_json }}
        icon: {{ tile.icon | to_json }}
        siteMonitor: {{ href | to_json }}
{% endfor %}
{% endfor %}
{% if homepage_links | length > 0 %}
- Links:
{% for link in homepage_links %}
    - {{ link.name | to_json }}:
        href: {{ link.href | to_json }}
{% if link.description is defined %}
        description: {{ link.description | to_json }}
{% endif %}
{% if link.icon is defined %}
        icon: {{ link.icon | to_json }}
{% endif %}
{% if link.monitor | default(false) %}
        siteMonitor: {{ link.href | to_json }}
{% endif %}
{% endfor %}
{% endif %}
