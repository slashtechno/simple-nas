# Ansible-managed — rendered directly by Ansible at deploy time.
# All accounts, volumes, and drives are baked in.
# To change: edit vars.yml/vault.yml and re-deploy.

[global]
  e2dsa
  e2ts
  xff-src: lan,100.64.0.0/10
  ui-filesz: 5c
  xff-hdr: cf-connecting-ip
  rproxy: 1
  shr: /shares
{% if sftp_enabled | default(false) | bool %}
  # sftp-pw reuses [accounts] below, no separate credential store.
  sftp: {{ sftp_port | default(3922) }}
  sftp-pw
{% endif %}

[accounts]
  {{ copyparty_user }}: {{ copyparty_pass }}
{% for u in vault_copyparty_collab_users | default([]) %}
  {{ u.user }}: {{ u.pass }}
{% endfor %}
{% if sftp_enabled | default(false) | bool %}
  {{ vault_pocketpi_nas_user }}: {{ vault_pocketpi_nas_pass }}
{% endif %}
{% for s in copyparty_service_accounts | default([]) %}
  {{ s.user }}: {{ s.pass }}
{% endfor %}

[/]
  /files
  accs:
    A: {{ copyparty_user }}
{% if sftp_enabled | default(false) | bool %}
    rwmd: {{ vault_pocketpi_nas_user }}  # m+d required -- rclone uploads/overwrites via rename
{% endif %}
  flags:
    daw

{# One volume per service-account folder, a subfolder of /files. Volflags don't
   carry over from [/], so daw is repeated to keep the admin's WebDAV
   overwrites working the same inside these folders. #}
{% for s in copyparty_service_accounts | default([]) %}
{% for v in s.volumes %}
[/{{ v.folder }}]
  /files/{{ v.folder }}
  accs:
    A: {{ copyparty_user }}
    {{ v.perms }}: {{ s.user }}
  flags:
    daw

{% endfor %}
{% endfor %}
{% if vault_copyparty_collab_users is defined and vault_copyparty_collab_users %}
[/collab]
  /collab
  accs:
    A: {{ copyparty_user }}
{% for u in vault_copyparty_collab_users %}
    A: {{ u.user }}
{% endfor %}
  flags:
    daw
{% endif %}

[/drives]
  /tmp/drives-root
  accs:
    r: {{ copyparty_user }}
  flags:
    -e2d
{% for drive in nas_drives if drive.mount != main_drive %}
[/drives/{{ drive.mount | basename }}]
  /host/mnt/{{ drive.mount | basename }}
  accs:
    r: {{ copyparty_user }}
  flags:
    -e2d
{% endfor %}
