# Ansible-managed — rendered directly by Ansible at deploy time.
# All accounts, volumes, and drives are baked in.
# To change: edit vars.yml/vault.yml and re-deploy.

[global]
  e2dsa
  e2ts
  # WebDAV write support, once globally — covers all volumes. Upstream has
  # no volflag inheritance (each volume is independent), but `daw` is ALSO a
  # global option, so per-volume repetition is unnecessary. Scoped negation
  # (`-daw` on a volume) still works here if ever needed (documented feature).
  daw
  # Thumbs/dbs/transcode cache on the fast drive (SSD) instead of a `.hist`
  # dir inside each volume. One-time: first boot after this change re-runs
  # the e2dsa index scan (db starts empty); thumbs regenerate lazily.
  hist: /hist
  # Cap thumbnailer RAM; default would allow ~2.4 GiB on a 4 GB Pi.
  th-ram-max: {{ copyparty_th_ram_max }}
{% if copyparty_version_checker_enabled | bool %}
  # Opt-in version checker: alerts in the log/UI when the running version is
  # affected by a security advisory. Phone-home is intentional (your choice).
  vc-url: https://api.copyparty.eu/advisories
{% endif %}
  xff-src: lan,100.64.0.0/10
  ui-filesz: 5c
  # Sort file2.txt before file10.txt, and default the UI's time display to the viewer's local
  # timezone instead of UTC (this is a browser-side default; the server's TZ is not involved).
  # Clients can still override both in the UI.
  nsort
  localtime
  # Default theme 2 = pm-monokai. Clients can still pick another in the UI settings.
  theme: 2
  xff-hdr: cf-connecting-ip
  rproxy: 1
  shr: /shares
{% if copyparty_sftp_enabled | bool %}
  # sftp-pw reuses [accounts] below, no separate credential store.
  sftp: {{ copyparty_sftp_port }}
  sftp-pw
{% endif %}

[accounts]
  {{ copyparty_user }}: {{ copyparty_pass }}
{% for u in vault_copyparty_collab_users | default([]) %}
  {{ u.user }}: {{ u.pass }}
{% endfor %}
{% if copyparty_sftp_enabled | bool %}
  {{ vault_pocketpi_nas_user }}: {{ vault_pocketpi_nas_pass }}
{% endif %}
{% for s in copyparty_service_accounts | default([]) %}
  {{ s.user }}: {{ s.pass }}
{% endfor %}

[/]
  /files
  accs:
    A: {{ copyparty_user }}
{% if copyparty_sftp_enabled | bool %}
    rwmd: {{ vault_pocketpi_nas_user }}  # m+d required -- rclone uploads/overwrites via rename
{% endif %}

{# One volume per service-account folder, a subfolder of /files. No per-volume
   flags needed: `daw` is set globally in [global], and volflags deliberately
   do NOT carry between volumes (unlike what inheritance would offer). #}
{% for s in copyparty_service_accounts | default([]) %}
{% for v in s.volumes %}
[/{{ v.folder }}]
  /files/{{ v.folder }}
  accs:
    A: {{ copyparty_user }}
    {{ v.perms }}: {{ s.user }}

{% endfor %}
{% endfor %}
{% if vault_copyparty_collab_users is defined and vault_copyparty_collab_users %}
[/collab]
  /collab
  accs:
    A: {{ copyparty_user }}
{% for u in vault_copyparty_collab_users %}
    A: {{ u.user }}
{% endfor %}
{% endif %}

{% if copyparty_fast_enabled | bool %}
[/fast]
  /fast
  accs:
    A: {{ copyparty_user }}

{% endif %}
[/drives]
  /tmp/drives-root
  accs:
    r: {{ copyparty_user }}
  flags:
    -e2d
{% for drive in drives if drive.mount != primary_drive %}
[/drives/{{ drive.mount | basename }}]
  /host/mnt/{{ drive.mount | basename }}
  accs:
    r: {{ copyparty_user }}
  flags:
    -e2d
{% endfor %}
