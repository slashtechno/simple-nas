# Ansible-managed. Edit vars.yml or vault.yml and redeploy; changes made here are overwritten.

{# Every admin has full access to every volume. An admin is a login with admin: true. #}
{% set admins = copyparty_accounts | selectattr('admin', 'defined') | selectattr('admin') | map(attribute='user') | list %}
[global]
  e2dsa
  e2ts
  # WebDAV write support for every volume. Volumes do not inherit flags, but `daw` is also a global option.
  daw
  # Thumbnails, databases and the transcode cache live in `copyparty_hist_dir` instead of a `.hist` folder inside each volume.
  hist: /hist
  # Cap the thumbnailer's RAM at 1 GiB (upstream's default is 60% of system RAM).
  th-ram-max: 1
  # Version checker: reports in the log and UI when the running version has a security advisory.
  # It fetches the advisory feed from the URL below.
  vc-url: https://api.copyparty.eu/advisories
  ui-filesz: 5c
  # Sort file2.txt before file10.txt, and show times in the viewer's local timezone (a browser-side default).
  nsort
  localtime
  # Default theme 2 = pm-monokai. Clients can still pick another in the UI settings.
  theme: 2
  # The tunnel and Caddy reach Copyparty over the Docker network and send X-Forwarded-For and -Proto, which Copyparty
  # trusts only from private addresses (lan). rproxy -1 takes the rightmost address, the one the nearest proxy added,
  # which a client cannot forge. Without these headers it sees plain http and rejects logins as cross-origin.
  xff-src: lan
  rproxy: -1
  shr: /shares
{% if copyparty_sso_enabled | bool %}
  # The user Tinyauth's login names in the Remote-User header is the Copyparty user, without a second login. Copyparty
  # ignores that header unless the request also carries a header whose NAME is the secret below (idp-h-key), and Caddy
  # sends it on the web address only, so the published port and the tunnel cannot claim a user. auth-ord tries that
  # header first and Copyparty's own passwords second, so WebDAV and apps keep their accounts.
  idp-h-usr: remote-user
  idp-h-key: {{ vault_copyparty_idp_key }}
  auth-ord: idp,pw
{% endif %}

[accounts]
{% for u in copyparty_accounts if u.pass is defined %}
  {{ u.user }}: {{ u.pass }}
{% endfor %}

{# One volume per folder. The address is /<name>; the container mounts the folder at /vol/<name> (docker-compose.yml). The admins have
   full access, and each login in the folder's access gets the letters listed there. #}
{% for name, folder in copyparty_volumes.items() %}
[/{{ name }}]
  /vol/{{ name }}
  accs:
{% for u in admins %}
    A: {{ u }}
{% endfor %}
{% for user, perms in folder.access.items() %}
    {{ perms }}: {{ user }}
{% endfor %}

{% endfor %}
{% if usb_automount_enabled | bool %}
{# USB drives plugged into the host; /host/usb is /run/media/system. #}
[/drives]
  /host/usb
  accs:
{% for u in admins %}
    {{ 'A' if usb_automount_writable | bool else 'r' }}: {{ u }}
{% endfor %}
  flags:
    -e2d
{% endif %}
