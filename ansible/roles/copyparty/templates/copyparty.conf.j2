# Ansible-managed. Edit vars.yml or vault.yml and redeploy; changes made here are overwritten.

[global]
  e2dsa
  e2ts
  # WebDAV write support for every volume. Volumes do not inherit flags, but `daw` is also a global option.
  daw
  # Thumbnails, databases and the transcode cache live in this one directory (the fast drive) instead of a
  # `.hist` folder inside each volume.
  hist: /hist
  # Cap the thumbnailer's RAM at 1 GiB (upstream's default is 60% of system RAM).
  th-ram-max: 1
  # Version checker: reports in the log and UI when the running version has a security advisory.
  # It fetches the advisory feed from the URL below.
  vc-url: https://api.copyparty.eu/advisories
  xff-src: lan,100.64.0.0/10
  ui-filesz: 5c
  # Sort file2.txt before file10.txt, and show times in the viewer's local timezone (a browser-side default).
  nsort
  localtime
  # Default theme 2 = pm-monokai. Clients can still pick another in the UI settings.
  theme: 2
  xff-hdr: cf-connecting-ip
  rproxy: 1
  shr: /shares
{% if copyparty_sftp_enabled | bool %}
  # sftp-pw reuses [accounts] below, no separate credential store.
  sftp: {{ copyparty_sftp_port }}
  sftp-pw
{% endif %}

[accounts]
  {{ copyparty_user }}: {{ copyparty_pass }}
{% for u in vault_copyparty_collab_users | default([]) %}
  {{ u.user }}: {{ u.pass }}
{% endfor %}
{% if copyparty_sftp_enabled | bool %}
  {{ vault_pocketpi_nas_user }}: {{ vault_pocketpi_nas_pass }}
{% endif %}
{% for s in copyparty_service_accounts | default([]) %}
  {{ s.user }}: {{ s.pass }}
{% endfor %}

[/]
  /files
  accs:
    A: {{ copyparty_user }}
{% if copyparty_sftp_enabled | bool %}
    rwmd: {{ vault_pocketpi_nas_user }}  # m+d required -- rclone uploads/overwrites via rename
{% endif %}

{# One volume per service-account folder, a subfolder of /files. #}
{% for s in copyparty_service_accounts | default([]) %}
{% for v in s.volumes %}
[/{{ v.folder }}]
  /files/{{ v.folder }}
  accs:
    A: {{ copyparty_user }}
    {{ v.perms }}: {{ s.user }}

{% endfor %}
{% endfor %}
{% if vault_copyparty_collab_users is defined and vault_copyparty_collab_users %}
[/collab]
  /collab
  accs:
    A: {{ copyparty_user }}
{% for u in vault_copyparty_collab_users %}
    A: {{ u.user }}
{% endfor %}
{% endif %}

{% if copyparty_fast_enabled | bool %}
[/fast]
  /fast
  accs:
    A: {{ copyparty_user }}

{% endif %}
{% if usb_automount_enabled | bool %}
{# USB drives plugged into the host; /host/usb is /run/media/system. #}
[/drives]
  /host/usb
  accs:
    {{ 'A' if usb_automount_writable | bool else 'r' }}: {{ copyparty_user }}
  flags:
    -e2d
{% endif %}
