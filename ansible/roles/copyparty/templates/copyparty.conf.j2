# Ansible-managed. Edit vars.yml or vault.yml and redeploy; changes made here are overwritten.

{# Every admin has full access to every volume: the password admin and the people Tinyauth signs in as admins. #}
{% set admins = [copyparty_user] + (copyparty_sso_admins if copyparty_sso_enabled | bool else []) %}
[global]
  e2dsa
  e2ts
  # WebDAV write support for every volume. Volumes do not inherit flags, but `daw` is also a global option.
  daw
  # Thumbnails, databases and the transcode cache live in `copyparty_hist_dir` instead of a `.hist` folder inside each volume.
  hist: /hist
  # Cap the thumbnailer's RAM at 1 GiB (upstream's default is 60% of system RAM).
  th-ram-max: 1
  # Version checker: reports in the log and UI when the running version has a security advisory.
  # It fetches the advisory feed from the URL below.
  vc-url: https://api.copyparty.eu/advisories
  ui-filesz: 5c
  # Sort file2.txt before file10.txt, and show times in the viewer's local timezone (a browser-side default).
  nsort
  localtime
  # Default theme 2 = pm-monokai. Clients can still pick another in the UI settings.
  theme: 2
  # The tunnel and Caddy reach Copyparty over the Docker network and send X-Forwarded-For and -Proto, which Copyparty
  # trusts only from private addresses (lan). rproxy -1 takes the rightmost address, the one the nearest proxy added,
  # which a client cannot forge. Without these headers it sees plain http and rejects logins as cross-origin.
  xff-src: lan
  rproxy: -1
  shr: /shares
{% if copyparty_sso_enabled | bool %}
  # The user Tinyauth's login names in the Remote-User header is the Copyparty user, without a second login. Copyparty
  # ignores that header unless the request also carries a header whose NAME is the secret below (idp-h-key), and Caddy
  # sends it on the browser name only, so the published port and the tunnel cannot claim a user. auth-ord tries that
  # header first and Copyparty's own passwords second, so WebDAV and apps keep their accounts.
  idp-h-usr: remote-user
  idp-h-key: {{ vault_copyparty_idp_key }}
  auth-ord: idp,pw
{% endif %}

[accounts]
  {{ copyparty_user }}: {{ copyparty_password }}
{% for u in copyparty_accounts %}
  {{ u.user }}: {{ u.pass }}
{% endfor %}
{% for app in copyparty_clients %}
  {{ app.key }}: {{ lookup('ansible.builtin.vars', app.copyparty.password) }}
{% endfor %}

[/]
  /files
  accs:
{% for u in admins %}
    A: {{ u }}
{% endfor %}

{% if copyparty_clients | length > 0 %}
{# The container's own /apps folder holds the bind mounts below, so /apps and /apps/<key> open as folders listing each app's volumes.
   Read-only: a file written here would live in the container, not on a drive. Not indexed: the photos are indexed by their own volume. #}
[/apps]
  /apps
  accs:
{% for u in admins %}
    r: {{ u }}
{% endfor %}
  flags:
    -e2d

{% endif %}
{# One volume per app volume. The address, the path in the container and the mount in docker-compose.yml are all /apps/<key>/<folder>. #}
{% for app in copyparty_clients %}
{% for v in app.copyparty.volumes %}
[/apps/{{ app.key }}/{{ v.folder }}]
  /apps/{{ app.key }}/{{ v.folder }}
  accs:
{% for u in admins %}
    A: {{ u }}
{% endfor %}
    {{ v.perms }}: {{ app.key }}

{% endfor %}
{% endfor %}
{# One volume per shared folder: the admins have full access, the accounts that list the folder read, write, move and delete in it (no
   admin rights). xvol stops a symlink inside the folder from reaching files outside it. #}
{% for folder in copyparty_shared_folders %}
[/{{ folder }}]
  /shared/{{ folder }}
  accs:
{% for u in admins %}
    A: {{ u }}
{% endfor %}
{% for u in copyparty_accounts if folder in u.folders %}
    rwmd: {{ u.user }}
{% endfor %}
  flags:
    xvol

{% endfor %}

{% if usb_automount_enabled | bool %}
{# USB drives plugged into the host; /host/usb is /run/media/system. #}
[/drives]
  /host/usb
  accs:
{% for u in admins %}
    {{ 'A' if usb_automount_writable | bool else 'r' }}: {{ u }}
{% endfor %}
  flags:
    -e2d
{% endif %}
