networks:
  {{ nas_network }}:
    external: true

services:
  copyparty:
    build:
      context: .
      args:
        BASE_IMAGE: {{ copyparty_base_image }}
    container_name: copyparty
    restart: unless-stopped
    volumes:
      - {{ copyparty_files_dir }}:/files:rw
      - {{ copyparty_config_dir }}:/cfg:rw
      - {{ copyparty_hist_dir }}:/hist:rw
{# Extra drives (see /drives in copyparty.conf). Role drives are never bound in. rslave lets drives
   plugged in later show up without restarting the container. A bind mount's :ro does NOT cover
   mounts that arrive after the container starts, so plugged-in drives are made read-only on the host. #}
{% for drive in extra_drives %}
      - {{ drive.mount }}:/host/drives/{{ drive.mount | basename }}:{{ 'rw' if extra_drives_writable | bool else 'ro' }},rslave
{% endfor %}
{% if usb_automount_enabled | bool %}
      - /run/media/system:/host/usb:rslave
{% endif %}
{% if copyparty_fast_enabled | bool %}
      - {{ copyparty_fast_dir }}:/fast:rw
{% endif %}
{% if copyparty_collab_dir is defined and copyparty_collab_dir %}
      - {{ copyparty_collab_dir }}:/collab:rw
{% endif %}
    environment:
      TZ: {{ timezone }}
    ports:
      - "{{ copyparty_port }}:3923"
{% if copyparty_sftp_enabled | bool %}
      - "{{ copyparty_sftp_port }}:{{ copyparty_sftp_port }}"
{% endif %}
    networks:
      - {{ nas_network }}
