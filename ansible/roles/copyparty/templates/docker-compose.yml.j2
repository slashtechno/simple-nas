# Ansible-managed — do not edit directly, edit vars.yml/vault.yml and re-deploy.
networks:
  {{ docker_network }}:
    external: true

services:
  copyparty:
    build:
      context: .
      args:
        BASE_IMAGE: {{ copyparty_base_image }}
    container_name: copyparty
    restart: unless-stopped
    volumes:
      - {{ copyparty_files_dir }}:/files:rw
      - {{ copyparty_config_dir }}:/cfg:rw
      - {{ copyparty_hist_dir }}:/hist:rw
{# rslave: drives plugged in after the container started still appear. #}
{% if usb_automount_enabled | bool %}
      - /run/media/system:/host/usb:rslave
{% endif %}
{% if copyparty_scratch_enabled | bool %}
      - {{ copyparty_scratch_dir }}:/scratch:rw
{% endif %}
{% if copyparty_collab_enabled | bool %}
      - {{ copyparty_collab_dir }}:/collab:rw
{% endif %}
{% for app in copyparty_clients %}
{% for v in app.copyparty.volumes %}
      - {{ lookup('ansible.builtin.vars', v.dir) }}:/apps/{{ app.key }}/{{ v.folder }}:rw
{% endfor %}
{% endfor %}
    environment:
      TZ: {{ timezone }}
{% if copyparty_port != '' or copyparty_extra_ports | length > 0 %}
    ports:
{% if copyparty_port != '' %}
      - "{{ copyparty_port }}:3923"
{% endif %}
{% for port in copyparty_extra_ports %}
      - "{{ port }}"
{% endfor %}
{% endif %}
    networks:
      - {{ docker_network }}
