networks:
  {{ docker_network }}:
    external: true

services:
  copyparty:
    build:
      context: .
      args:
        BASE_IMAGE: {{ copyparty_base_image }}
    container_name: copyparty
    restart: unless-stopped
    volumes:
      - {{ copyparty_files_dir }}:/files:rw
      - {{ copyparty_config_dir }}:/cfg:rw
      - {{ copyparty_hist_dir }}:/hist:rw
{# rslave: drives plugged in after the container started still appear. #}
{% if usb_automount_enabled | bool %}
      - /run/media/system:/host/usb:rslave
{% endif %}
{% if copyparty_fast_enabled | bool %}
      - {{ copyparty_fast_dir }}:/fast:rw
{% endif %}
{% if copyparty_collab_enabled | bool %}
      - {{ copyparty_collab_dir }}:/collab:rw
{% endif %}
    environment:
      TZ: {{ timezone }}
{% if copyparty_port != '' or copyparty_sftp_enabled | bool %}
    ports:
{% if copyparty_port != '' %}
      - "{{ copyparty_port }}:3923"
{% endif %}
{% if copyparty_sftp_enabled | bool %}
      - "{{ copyparty_sftp_port }}:{{ copyparty_sftp_port }}"
{% endif %}
{% endif %}
    networks:
      - {{ docker_network }}
