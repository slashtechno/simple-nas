networks:
  {{ nas_network }}:
    external: true

services:
  copyparty:
    build:
      context: .
      args:
        BASE_IMAGE: {{ copyparty_base_image }}
    container_name: copyparty
    restart: unless-stopped
    volumes:
      - {{ copyparty_files_dir }}:/files:rw
      - {{ copyparty_config_dir }}:/cfg:rw
      - {{ copyparty_hist_dir }}:/hist:rw
      - {{ host_mnt_dir }}:/host/mnt:ro,rslave
{% if copyparty_collab_dir is defined and copyparty_collab_dir %}
      - {{ copyparty_collab_dir }}:/collab:rw
{% endif %}
    environment:
      TZ: {{ timezone }}
    ports:
      - "{{ copyparty_port }}:3923"
{% if sftp_enabled | bool %}
      - "{{ sftp_port }}:{{ sftp_port }}"
{% endif %}
    networks:
      - {{ nas_network }}
