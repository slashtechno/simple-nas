# Ansible-managed — do not edit directly, edit vars.yml/vault.yml and re-deploy.
#
# Crafty runs every Minecraft server as a process inside this one container, so all servers
# share its memory cap, its data root and its published ports. Not in cloudflared_ingress:
# the panel is HTTPS with a self-signed cert and Minecraft is raw TCP, neither of which a
# Cloudflare tunnel can carry. Reach both over the LAN or Tailscale. The panel joins services so
# Caddy can give it a name (web_services, group_vars/all/web_services.yml).
networks:
  {{ docker_network }}:
    external: true

services:
  crafty:
    image: registry.gitlab.com/crafty-controller/crafty-4:{{ crafty_version }}
    container_name: crafty
    restart: unless-stopped
    mem_limit: {{ crafty_memory_limit }}
    networks:
      - {{ docker_network }}
    environment:
      TZ: {{ timezone }}
    ports:
      - "{{ crafty_port }}:8443"
      - "{{ crafty_mc_ports }}:{{ crafty_mc_ports }}"
{% if crafty_bedrock_enabled %}
      - "19132:19132/udp"
{% endif %}
    volumes:
      - {{ crafty_data_dir }}/servers:/crafty/servers
      - {{ crafty_data_dir }}/backups:/crafty/backups
      - {{ crafty_data_dir }}/logs:/crafty/logs
      - {{ crafty_data_dir }}/config:/crafty/app/config
      - {{ crafty_data_dir }}/import:/crafty/import
