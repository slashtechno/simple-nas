{{ gitea_data_dir }}/ssh
{% endif %}
{% if immich_enabled | bool %}
{{ immich_db_data_location }}
{% endif %}
{% if copyparty_enabled | bool %}
{{ copyparty_config_dir }}/copyparty
{{ copyparty_hist_dir }}
{% endif %}
{% if crafty_enabled | bool %}
