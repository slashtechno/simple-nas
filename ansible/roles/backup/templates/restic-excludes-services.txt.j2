# Patterns shared by the local and cloud exclude lists (included by both).
{% for folder in encrypted_pairs %}
# The encrypted copy of {{ folder.mount }}: restic backs up the decrypted files, so saving these too would store everything twice.
{{ folder.cipher }}
{% endfor %}
{% if docker_data_root | length > 0 %}
# Docker's images and layers: root-owned and rebuilt by pulling.
{{ docker_data_root }}
{% endif %}
{% if caddy_enabled | bool %}
# Root-owned by the Caddy container, mode 700: the backup user cannot read it, so without this line
# every local run fails with restic exit 3. The certificate and ACME key files regenerate after a restore.
{{ caddy_data_dir }}/caddy
{% endif %}
{% if cloudflared_enabled | bool %}
# Owned by the Cloudflare container's user, mode 400: the backup user cannot read it, so without this line every
# run fails with restic exit 3. A deploy writes it again from Cloudflare.
{{ services_dir }}/cloudflared/token
{% endif %}
{% if gitea_enabled | bool %}
{{ gitea_data_dir }}/ssh
{% endif %}
{% if immich_enabled | bool %}
{{ immich_db_data_location }}
{% endif %}
{% if copyparty_enabled | bool %}
{{ copyparty_config_dir }}/copyparty
{{ copyparty_hist_dir }}
{% endif %}
{% if garage_enabled | bool %}
# Root-owned and a live database: the backup user cannot read it, and Garage's dump (garage.sh) carries a
# consistent copy.
{{ garage_data_dir }}/meta
{% endif %}
{% if crafty_enabled | bool %}
# Crafty's own backup archives: they dedupe badly and would grow the repo. The live servers/ copy is
# still backed up. Add "!{{ crafty_data_dir }}/backups" as a "- !" line of restic_local_rules or restic_cloud_rules to back them up too.
{{ crafty_data_dir }}/backups
{% endif %}
