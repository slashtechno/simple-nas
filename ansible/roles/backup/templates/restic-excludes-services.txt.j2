# Patterns shared by the local and cloud exclude lists (included by both).
{% for folder in encrypted_pairs %}
# The encrypted copy of {{ folder.mount }}: restic backs up the decrypted files, so saving these too would store everything twice.
# Only gocryptfs.conf is kept: it is small, holds the cipher and the master key (encrypted under the passphrase), and is
# what the folder cannot be opened without (docs/encryption.md).
{{ folder.cipher }}/*
!{{ folder.cipher }}/gocryptfs.conf
{% endfor %}
# Credentials: restic's own password and the Drive token must never be in a backup, even under a path you add.
# By default they sit in the user's home, which the local backup covers on a host with no fast or primary drive. The `*` also covers the
# copy a deploy keeps when it replaces the password file (.restic-password.<pid>.<date>~).
{{ restic_password_file }}*
{{ rclone_config_dir }}
# The Cloudflare tunnel token: a deploy writes it again from Cloudflare. A line for it stays when cloudflared_enabled is off.
{{ cloudflared_token_file }}
# The tokens of the alerts: a deploy writes them again from the vault.
{{ alert_token_dir }}
# The alert script holds the destination address, which may be a secret topic name; a deploy writes it again.
{{ scripts_dir }}/alert.sh
{% if docker_data_root | length > 0 %}
# Docker's images and layers: root-owned and rebuilt by pulling.
{{ docker_data_root }}
{% endif %}
# The directories each enabled service lists as no_backup in group_vars/all/services.yml, and the folders inside its
# data directories that it lists as no_backup_in (the reason is in services.yml). To back one up, add its "!" line to
# restic_local_rules or restic_cloud_rules (docs/backups.md).
{% for path in query('ansible.builtin.vars', *(services | selectattr('key', 'in', enabled_service_keys) | map(attribute='no_backup', default=[]) | flatten | select | list)) %}
{{ path }}
{% endfor %}
{% for entry in services | selectattr('key', 'in', enabled_service_keys) | map(attribute='no_backup_in', default={}) %}
{% for setting, folder in entry.items() %}
{{ query('ansible.builtin.vars', setting) | first }}/{{ folder }}
{% endfor %}
{% endfor %}
