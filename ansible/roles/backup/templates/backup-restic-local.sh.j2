#!/bin/bash
set -o pipefail

# Refuse to run if the backup drive is not mounted at {{ backup_drive }}: restic would write the
# repository onto the root filesystem, under the empty mount point, until it fills.
if ! mountpoint -q {{ backup_drive | quote }}; then
  echo "ERROR: {{ backup_drive }} is not a mounted filesystem — refusing to back up onto root. Check the backup drive (check the USB connection; the drive mounts itself when it is back)." >&2
  exit 1
fi

{% for mount in data_drive_mounts %}
# Refuse to run if {{ mount }} is not mounted: restic would save a snapshot of an empty folder, and each such
# snapshot counts toward retention and pushes out good ones.
if ! mountpoint -q {{ mount | quote }}; then
  echo "ERROR: {{ mount }} is not a mounted filesystem — refusing to back up an empty folder. Check the drive (check the USB connection; the drive mounts itself when it is back)." >&2
  exit 1
fi
{% endfor %}

# The password-file path is set at deploy time; the environment variable overrides it for a manual run.
export RESTIC_PASSWORD_FILE="${RESTIC_PASSWORD_FILE:-{{ restic_password_file }}}"
export RESTIC_REPOSITORY="{{ restic_repo_path }}"
# restic's index and snapshot cache. It helps only when its drive differs from the repository's.
export RESTIC_CACHE_DIR="${RESTIC_CACHE_DIR:-{{ restic_cache_dir }}}"

# A hung restic must end as a failed run, not hold the repository lock (see backup-restic-cloud.sh.j2).
restic() { timeout "{{ restic_command_timeout }}" /usr/bin/restic "$@"; }

LOG_FILE="{{ backup_logs_dir }}/restic-local-$(date +%Y-%m-%d).log"
mkdir -p "$(dirname "$LOG_FILE")"

# Exclude patterns: restic-excludes-local.txt next to this script.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
EXCLUDE_FILE="$SCRIPT_DIR/restic-excludes-local.txt"

{
  echo "=== Local Backup: $(date) ==="
  # A restic killed mid-run (reboot, power loss) leaves its lock behind, and every later forget --prune fails
  # on it. `unlock` removes only stale locks (not refreshed for 30 minutes); a live backup's lock stays.
  restic unlock
  # Dump the databases first (Immich, Gitea); the dumps are backed up below.
  bash "$SCRIPT_DIR/backup-services.sh" || { echo "Service dump failed"; exit 1; }

  # Back up the paths in restic_local_rules plus the dumps dir. Keep the path
  # list stable: restic forget groups snapshots by host and paths, so changing
  # it starts a new group and the old group's last snapshots stay until you
  # forget them by hand. Add "- " lines to restic_local_rules to skip things instead.
  restic backup {{ (restic_local_rules | reject('match', '^- ') | list + [service_dumps_dir]) | unique | map('quote') | join(' ') }} \
    --exclude-file "$EXCLUDE_FILE" \
    --tag daily \
    --verbose
  backup_rc=$?

  # Exit 0 is success. Exit 3 means the snapshot was saved but some source files could not be read
  # (a socket, a file that changed mid-scan); it still prunes, so unreadable files cannot stop pruning.
  if [ "$backup_rc" -eq 0 ] || [ "$backup_rc" -eq 3 ]; then
    if [ "$backup_rc" -eq 3 ]; then
      echo "Backup completed with some unreadable source files (exit 3) — snapshot saved, pruning anyway."
    else
      echo "Backup successful. Removing old snapshots..."
    fi
    restic forget {{ restic_local_retention }} --prune || { echo "ERROR: restic forget --prune failed!"; exit 1; }

    echo "Repository stats:"
    restic stats || { echo "ERROR: restic stats failed!"; exit 1; }
    echo "Free space on HDD:"
    df -h {{ backup_drive | quote }}
  else
    echo "ERROR: Backup failed (restic exit code $backup_rc)!"
    exit 1
  fi
  
  echo "=== Complete: $(date) ==="
} 2>&1 | tee -a "$LOG_FILE"