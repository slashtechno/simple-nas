#!/bin/bash
{% import 'mount-guards.j2' as guards with context %}
{% import 'status-report.j2' as job_status with context %}
{% import 'restic-env.j2' as restic_env with context %}
set -o pipefail

{% if backup_local_enabled | bool %}
# Refuse to run if the backup drive is not mounted at {{ backup_drive }}: the service dumps and logs
# are written there, and they would fill the root drive instead.
{{ guards.require_mounted(backup_drive, 'refusing to back up onto root') }}

{% endif %}
{{ guards.require_data_drives() }}

{{ job_status.setup('cloud') }}

{{ restic_env.setup(restic_cloud_repository) }}

# Throttles rclone's request rate to stay under Google Drive's quota (restic_cloud_rclone_args in group_vars).
RESTIC_RCLONE_OPT=(-o "rclone.args={{ restic_cloud_rclone_args }}")

# The paths to back up: backup-paths.txt next to this script. Comment lines are skipped.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
BACKUP_PATHS_FILE="$SCRIPT_DIR/backup-paths.txt"
if [ ! -f "$BACKUP_PATHS_FILE" ]; then
  echo "ERROR: backup paths file not found: $BACKUP_PATHS_FILE" >&2
  exit 1
fi
mapfile -t BACKUP_PATHS < <(grep -v '^[[:space:]]*\(#\|$\)' "$BACKUP_PATHS_FILE")
if [ -z "${BACKUP_PATHS[*]}" ]; then
  echo "ERROR: no paths listed in $BACKUP_PATHS_FILE" >&2
  exit 1
fi

# Exclude patterns: restic-excludes-cloud.txt next to this script.
EXCLUDE_FILE="$SCRIPT_DIR/restic-excludes-cloud.txt"

LOG_FILE="{{ backup_logs_dir }}/restic-cloud-$(date +%Y-%m-%d).log"
mkdir -p "$(dirname "$LOG_FILE")"

{
  echo "=== Cloud Backup: $(date) ==="
  {{ restic_env.unlock_note() | indent(2) }}
  restic "${RESTIC_RCLONE_OPT[@]}" unlock
  # Dump the databases first (Immich, Gitea); the dumps are backed up below.
  bash "$SCRIPT_DIR/backup-services.sh" || { echo "Service dump failed"; exit 1; }

  # Exit 0 is success. Exit 3 means the snapshot was saved but some source files could not be read:
  # it sets any_partial, which fails the run after pruning so the alert fires. Any other non-zero exit
  # sets cloud_backup_failed.
  cloud_backup_failed=false
  any_partial=false

  # Backup service dumps first
  if [ -d "{{ service_dumps_dir }}" ]; then
    restic "${RESTIC_RCLONE_OPT[@]}" backup "{{ service_dumps_dir }}" --tag weekly --verbose
    rc=$?
    [ "$rc" -eq 3 ] && any_partial=true
    [ "$rc" -ne 0 ] && [ "$rc" -ne 3 ] && cloud_backup_failed=true
  fi

  # Backup critical paths from backup-paths.txt
  for path in "${BACKUP_PATHS[@]}"; do
    if [ -e "$path" ]; then
      echo "Backing up $path..."
      restic "${RESTIC_RCLONE_OPT[@]}" backup "$path" --exclude-file "$EXCLUDE_FILE" --tag weekly --verbose
      rc=$?
      [ "$rc" -eq 3 ] && any_partial=true
      [ "$rc" -ne 0 ] && [ "$rc" -ne 3 ] && cloud_backup_failed=true
    else
      echo "ERROR: backup path is missing: $path"
      cloud_backup_failed=true
    fi
  done

  if ! $cloud_backup_failed; then
    echo "Cloud backup saved. Removing old snapshots..."
    restic "${RESTIC_RCLONE_OPT[@]}" forget {{ restic_cloud_retention }} --prune \
      || { echo "ERROR: restic forget --prune failed!"; exit 1; }

    echo "Cloud repository stats:"
    restic "${RESTIC_RCLONE_OPT[@]}" stats \
      || { echo "ERROR: restic stats failed!"; exit 1; }

    # The backup-status dashboard has no cloud credentials; it reads this snapshot list instead.
    # A failure here does not fail the backup.
    restic "${RESTIC_RCLONE_OPT[@]}" snapshots --json > "{{ backup_logs_dir }}/cloud-snapshots.json.tmp" \
      && mv "{{ backup_logs_dir }}/cloud-snapshots.json.tmp" "{{ backup_logs_dir }}/cloud-snapshots.json" \
      || echo "Warning: could not refresh cloud-snapshots.json cache for the dashboard"
  else
    echo "ERROR: Cloud backup failed!"
    exit 1
  fi
  
  if $any_partial; then
    echo "ERROR: restic could not read some source files (the \"error:\" lines above). The snapshots are saved without them: fix their permissions or exclude them (docs/backups.md#choosing-what-is-backed-up)."
    exit 1
  fi

  echo "=== Complete: $(date) ==="
} 2>&1 | tee -a "$LOG_FILE"