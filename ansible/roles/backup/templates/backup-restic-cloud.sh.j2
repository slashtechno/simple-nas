#!/bin/bash
set -o pipefail

# Refuse to run if the backup drive isn't actually mounted at {{ backup_drive }} —
# otherwise this silently writes onto the root filesystem until it fills up
# (this has happened: a USB dropout unmounted the drive mid-write, and cron
# kept "succeeding" against the bare mountpoint directory).
if ! mountpoint -q {{ backup_drive }}; then
  echo "ERROR: {{ backup_drive }} is not a mounted filesystem — refusing to back up onto root. Check the backup drive (USB connection, then: sudo mount -a)." >&2
  exit 1
fi

export RESTIC_PASSWORD_FILE="{{ restic_password_file }}"
export RESTIC_REPOSITORY="{{ restic_cloud_repository }}"
# Cache on the fast drive: for the rclone/gdrive repo this matters most —
# restic avoids re-reading packs over the network during backup/check/forget.
# Explicit-override form keeps manual test runs able to point elsewhere.
export RESTIC_CACHE_DIR="${RESTIC_CACHE_DIR:-{{ restic_cache_dir }}}"

# rclone's shared default Google OAuth client hits Drive's per-minute quota
# fast on a burst of small-file uploads — this throttles request rate to
# stay under it. See the restic_cloud_rclone_args comment in group_vars.
RESTIC_RCLONE_OPT=(-o "rclone.args={{ restic_cloud_rclone_args }}")

# A stalled rclone/network pipe can deadlock restic indefinitely while it
# still holds the repo lock (seen in practice: 6 days stuck, ~2m of actual
# CPU time). `timeout` guarantees a hang becomes a normal failed cron run
# instead of silently blocking every later cloud backup/prune.
restic() { timeout "{{ restic_command_timeout }}" /usr/bin/restic "$@"; }

# The cloud paths live in backup-paths.txt next to this script (rendered from
# roles/backup/templates/backup-paths.txt.j2). Comment lines are skipped.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
BACKUP_PATHS_FILE="$SCRIPT_DIR/backup-paths.txt"
if [ ! -f "$BACKUP_PATHS_FILE" ]; then
  echo "ERROR: backup paths file not found: $BACKUP_PATHS_FILE" >&2
  exit 1
fi
mapfile -t BACKUP_PATHS < <(grep -v '^[[:space:]]*\(#\|$\)' "$BACKUP_PATHS_FILE")

# Exclude patterns live in restic-excludes-cloud.txt next to this script.
EXCLUDE_FILE="$SCRIPT_DIR/restic-excludes-cloud.txt"

LOG_FILE="{{ backup_logs_dir }}/restic-cloud-$(date +%Y-%m-%d).log"
mkdir -p "$(dirname "$LOG_FILE")"

{
  echo "=== Cloud Backup: $(date) ==="
  # Dump the databases first (Immich, Gitea); the dumps are backed up below.
  bash "$SCRIPT_DIR/backup-services.sh" || { echo "Service dump failed"; exit 1; }

  # restic's exit codes: 0 = clean success, 3 = the snapshot was still saved
  # but some source files couldn't be read — a partial success, not a
  # failure. cloud_backup_failed only trips on a real error (anything other
  # than 0/3); any_partial just gets a note in the log. Tracked explicitly
  # per call rather than reading $? once after the whole loop, since that
  # only ever reflected whichever command happened to run last.
  cloud_backup_failed=false
  any_partial=false

  # Backup service dumps first
  if [ -d "{{ service_dumps_dir }}" ]; then
    restic "${RESTIC_RCLONE_OPT[@]}" backup "{{ service_dumps_dir }}" --tag weekly --verbose
    rc=$?
    [ "$rc" -eq 3 ] && any_partial=true
    [ "$rc" -ne 0 ] && [ "$rc" -ne 3 ] && cloud_backup_failed=true
  fi

  # Backup critical paths from backup-paths.txt
  for path in "${BACKUP_PATHS[@]}"; do
    if [ -d "$path" ]; then
      echo "Backing up $path..."
      restic "${RESTIC_RCLONE_OPT[@]}" backup "$path" --exclude-file "$EXCLUDE_FILE" --tag weekly --verbose
      rc=$?
      [ "$rc" -eq 3 ] && any_partial=true
      [ "$rc" -ne 0 ] && [ "$rc" -ne 3 ] && cloud_backup_failed=true
    else
      echo "Skipping missing path: $path"
    fi
  done

  if ! $cloud_backup_failed; then
    if $any_partial; then
      echo "Cloud backup completed with some unreadable source files — snapshots saved, pruning anyway."
    else
      echo "Cloud backup successful. Removing old snapshots..."
    fi
    restic "${RESTIC_RCLONE_OPT[@]}" forget {{ restic_cloud_retention }} --prune

    echo "Cloud repository stats:"
    restic "${RESTIC_RCLONE_OPT[@]}" stats

    # The backup-status dashboard has no cloud credentials of its own (by
    # design — see its README section); this cache file is how it shows
    # cloud snapshots anyway, without needing any. Best-effort: a failure
    # here shouldn't fail an otherwise-successful backup.
    restic "${RESTIC_RCLONE_OPT[@]}" snapshots --json > "{{ backup_logs_dir }}/cloud-snapshots.json.tmp" \
      && mv "{{ backup_logs_dir }}/cloud-snapshots.json.tmp" "{{ backup_logs_dir }}/cloud-snapshots.json" \
      || echo "Warning: could not refresh cloud-snapshots.json cache for the dashboard"
  else
    echo "ERROR: Cloud backup failed!"
    exit 1
  fi
  
  echo "=== Complete: $(date) ==="
} | tee -a "$LOG_FILE"