#!/bin/bash
set -o pipefail

if ! mountpoint -q {{ backup_drive | quote }}; then
  echo "ERROR: {{ backup_drive }} is not a mounted filesystem — skipping integrity check." >&2
  exit 1
fi

export RESTIC_PASSWORD_FILE="${RESTIC_PASSWORD_FILE:-{{ restic_password_file }}}"
export RESTIC_REPOSITORY="{{ restic_repo_path }}"
export RESTIC_CACHE_DIR="${RESTIC_CACHE_DIR:-{{ restic_cache_dir }}}"

# See the matching comment in backup-restic-cloud.sh.j2 — a stalled check
# should become a failed cron run, not a lock held forever.
restic() { timeout "{{ restic_command_timeout }}" /usr/bin/restic "$@"; }

# One log file per day; every run appends a "=== Integrity Check" header, and the dashboard
# judges only the text after the last header. 2>&1 matters: restic prints its "error:" lines on
# stderr, and the dashboard counts them in this log.
LOG_FILE="{{ backup_logs_dir }}/restic-check-$(date +%Y-%m-%d).log"
mkdir -p "$(dirname "$LOG_FILE")"

{
  echo "=== Integrity Check: $(date) ==="
  restic check
  check_rc=$?
  if [ "$check_rc" -eq 0 ]; then
    echo "=== Complete: $(date) ==="
  else
    echo "ERROR: restic check failed (exit $check_rc)!"
    exit 1
  fi
} 2>&1 | tee -a "$LOG_FILE"
