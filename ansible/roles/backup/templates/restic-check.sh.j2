#!/bin/bash
{% import 'mount-guards.j2' as guards with context %}
{% import 'status-report.j2' as job_status with context %}
{% import 'restic-env.j2' as restic_env with context %}
set -o pipefail

{{ guards.require_mounted(backup_drive, 'skipping integrity check') }}

{{ job_status.setup('check') }}

{{ restic_env.setup(restic_repo_path) }}

# One log file per day; every run appends a "=== Integrity Check" header. 2>&1 matters: restic prints its
# "error:" lines on stderr, and this log is where you read them.
LOG_FILE="{{ backup_logs_dir }}/restic-check-$(date +%Y-%m-%d).log"
mkdir -p "$(dirname "$LOG_FILE")"

{
  echo "=== Integrity Check: $(date) ==="
  {{ restic_env.unlock_note() | indent(2) }}
  restic unlock
  # Checks the repository structure and reads a 5% sample of the stored data.
  restic check --read-data-subset=5%
  check_rc=$?
  if [ "$check_rc" -eq 0 ]; then
    echo "=== Complete: $(date) ==="
  else
    echo "ERROR: restic check failed (exit $check_rc)!"
    exit 1
  fi
} 2>&1 | tee -a "$LOG_FILE"
