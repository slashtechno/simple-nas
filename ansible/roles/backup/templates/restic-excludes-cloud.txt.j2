# Patterns the cloud (weekly) backup skips, one per line; lines starting with # are ignored.
# Rendered by Ansible: edit the "- " lines of restic_cloud_rules in group_vars, not this file.
# Syntax is restic's, not gitignore's: https://restic.readthedocs.io/en/stable/040_backup.html
# `**` matches any number of directories; a leading `!` re-includes something an
# EARLIER line excluded. You cannot re-include files inside a directory that is
# excluded as a whole.

# Defaults: caches that can be rebuilt.
{{ restic_cache_dir }}
**/.cache
# Credentials: restic's own password and the Drive token must never be in a backup, even under a path you add.
{{ restic_password_file }}
/home/{{ ansible_user }}/.config/rclone
{% include 'restic-excludes-services.txt.j2' %}

# Yours: the "- " lines of restic_cloud_rules, with the "- " removed ("- !" becomes "!")
{% for rule in restic_cloud_rules | select('match', '^- ') %}
{{ rule[2:] }}
{% endfor %}
