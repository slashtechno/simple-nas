#!/bin/bash
set -euo pipefail

# Runs every dump script in {{ service_dump_scripts_dir }}/ and writes the dumps to
# {{ service_dumps_dir }}/. Called by the restic backup scripts before they run.
#
# Each service with a live database installs its own script there from its role
# (roles/immich/files/dump.sh, roles/gitea/files/dump.sh), so a service that is
# not deployed leaves no script. A script receives the dump directory as $1 and
# names its output <script name>-*, e.g. immich.sh writes immich-db-*.sql.gz.
# Services that are plain files (Copyparty, pics, Homebridge, Garage, Crafty)
# need no script: restic copies them directly.
#
# The loop below is deliberate, not run-parts: run-parts only runs names made of
# letters, digits, _ and - (see man run-parts), so it would skip immich.sh.

DUMP_DIR="${DUMP_DIR:-{{ service_dumps_dir }}}"
SCRIPTS_DIR="{{ service_dump_scripts_dir }}"

{% if 'backup' in drive_mounts %}
# Refuse to run if the backup drive isn't mounted — otherwise this silently
# creates $DUMP_DIR (and writes DB dumps into it) on the root filesystem.
if ! mountpoint -q {{ backup_drive | quote }}; then
  echo "ERROR: {{ backup_drive }} is not a mounted filesystem — refusing to write dumps onto root. Check the backup drive (USB connection, then: sudo mount -a)." >&2
  exit 1
fi

{% endif %}
mkdir -p "$DUMP_DIR"
shopt -s nullglob

failed=false
for script in "$SCRIPTS_DIR"/*.sh; do
  name="$(basename "$script" .sh)"
  echo "Running dump script: $name"
  if ! bash "$script" "$DUMP_DIR"; then
    echo "ERROR: dump script $name failed" >&2
    failed=true
    continue   # keep the old dumps: they may be the only good ones
  fi
  # Keep only the last 3 dumps of this service
  find "$DUMP_DIR" -maxdepth 1 -name "${name}-*" -type f | sort -r | tail -n +4 | xargs -r rm -f
done

if $failed; then
  exit 1
fi
echo "Service dumps complete in $DUMP_DIR"
