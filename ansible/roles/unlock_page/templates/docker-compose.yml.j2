networks:
  {{ docker_network }}:
    external: true

services:
  unlock-page:
    build:
      context: .
      args:
        PYTHON_IMAGE: {{ python_image }}
    container_name: unlock-page
    restart: unless-stopped
    environment:
      TZ: {{ timezone }}
    # The folder with the socket (unlock-page.socket), read-only: the page can ask the host for three things and nothing else.
    volumes:
      - {{ unlock_page_socket_dir }}:/run/unlock:ro
    networks:
      - {{ docker_network }}
