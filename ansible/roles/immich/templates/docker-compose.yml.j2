networks:
  {{ nas_network }}:
    external: true

services:
  immich_server:
    image: ghcr.io/immich-app/immich-server:{{ immich_version }}
    container_name: immich_server
    restart: unless-stopped
    command: ["start.sh", "immich"]
    volumes:
      - {{ immich_upload_location }}:/data
      - /etc/localtime:/etc/localtime:ro
    environment:
      DB_HOSTNAME: immich_postgres
      DB_USERNAME: immich
      DB_PASSWORD: '{{ vault_immich_db_password | replace("$", "$$") }}'
      DB_DATABASE_NAME: immich
      TZ: {{ timezone }}
    ports:
      - "2283:2283"
    networks:
      - {{ nas_network }}
    depends_on:
      - immich_postgres
      - immich_redis
      - immich_machine_learning

  immich_machine_learning:
    image: ghcr.io/immich-app/immich-machine-learning:{{ immich_version }}
    container_name: immich_machine_learning
    restart: unless-stopped
    volumes:
      - model-cache:/cache
      - /etc/localtime:/etc/localtime:ro
    environment:
      TZ: {{ timezone }}
    networks:
      {{ nas_network }}:
        aliases:
          - immich-machine-learning

  immich_postgres:
    image: {{ immich_postgres_image }}
    container_name: immich_postgres
    restart: unless-stopped
    environment:
      POSTGRES_PASSWORD: '{{ vault_immich_db_password | replace("$", "$$") }}'
      POSTGRES_USER: immich
      POSTGRES_DB: immich
      POSTGRES_INITDB_ARGS: '--data-checksums'
    volumes:
      - {{ immich_db_data_location }}:/var/lib/postgresql/data
    networks:
      - {{ nas_network }}

  immich_redis:
    image: {{ immich_valkey_image }}
    container_name: immich_redis
    hostname: redis
    restart: unless-stopped
    healthcheck:
      test: redis-cli ping || exit 1
    networks:
      - {{ nas_network }}

volumes:
  model-cache:
