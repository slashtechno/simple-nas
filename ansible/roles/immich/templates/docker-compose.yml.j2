# Ansible-managed — do not edit directly, edit vars.yml/vault.yml and re-deploy.
networks:
  {{ docker_network }}:
    external: true

services:
  immich_server:
    image: {{ immich_server_image }}
    container_name: immich_server
    restart: unless-stopped
    command: ["start.sh", "immich"]
    volumes:
      - {{ immich_photos_dir }}:/data
    environment:
      TZ: {{ timezone }}
      DB_HOSTNAME: immich_postgres
      # Same role name as POSTGRES_USER below, files/dump.sh and restore-services.sh.
      DB_USERNAME: immich
      DB_PASSWORD: '{{ vault_immich_db_password | replace("$", "$$") }}'
      DB_DATABASE_NAME: immich
{% if immich_port != '' %}
    ports:
      - "{{ immich_port }}:2283"
{% endif %}
    networks:
      - {{ docker_network }}
    depends_on:
      - immich_postgres
      - immich_redis
      - immich_machine_learning

  immich_machine_learning:
    image: {{ immich_machine_learning_image }}
    container_name: immich_machine_learning
    restart: unless-stopped
{% if immich_machine_learning_memory_limit != '' %}
    mem_limit: {{ immich_machine_learning_memory_limit }}
{% endif %}
    volumes:
      - model-cache:/cache
    environment:
      TZ: {{ timezone }}
    networks:
      {{ docker_network }}:
        # Immich looks up the machine-learning container by this name by default.
        aliases:
          - immich-machine-learning

  immich_postgres:
    image: {{ immich_postgres_image }}
    container_name: immich_postgres
    restart: unless-stopped
    environment:
      POSTGRES_PASSWORD: '{{ vault_immich_db_password | replace("$", "$$") }}'
      POSTGRES_USER: immich
      POSTGRES_DB: immich
      POSTGRES_INITDB_ARGS: '--data-checksums'
    volumes:
      - {{ immich_postgres_dir }}:/var/lib/postgresql/data
    networks:
      - {{ docker_network }}

  immich_redis:
    image: {{ immich_valkey_image }}
    container_name: immich_redis
    # Immich looks up Redis by the name "redis" by default.
    hostname: redis
    restart: unless-stopped
    healthcheck:
      test: redis-cli ping || exit 1
    networks:
      - {{ docker_network }}

volumes:
  model-cache:
