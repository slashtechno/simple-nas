# Ansible-managed — do not edit directly, edit the tinyauth_* settings and re-deploy.
# The login page for the web services behind Tinyauth (docs/services.md#tinyauth-login). The compose file is
# mode 0640 because it holds the users' password hashes; `$` is written `$$` because compose would read it as a variable.
networks:
  {{ docker_network }}:
    external: true

services:
  tinyauth:
    image: {{ tinyauth_image }}
    container_name: tinyauth
    restart: unless-stopped
{% if tinyauth_port != '' %}
    ports:
      - "{{ tinyauth_port }}:3000"
{% endif %}
    volumes:
      # The session database. Without it every container recreate logs everyone out.
      - {{ tinyauth_data_dir }}:/data
    environment:
      TZ: {{ timezone }}
      # The login page's own address. The session cookie is set for its parent domain, so every protected service
      # must be a name under the same private domain.
      TINYAUTH_APPURL: "https://{{ tinyauth_subdomain }}.{{ caddy_private_domains[0] }}"
      # name:bcrypt-hash[:totp-secret], separated by commas. Tinyauth wants a hash, so the vault passwords are hashed here
      # (a fixed salt keeps the output the same on every run, as for ntfy and Garage).
      TINYAUTH_AUTH_USERS: '{% for user in vault_tinyauth_users %}{{ user.name }}:{{ user.password | password_hash('bcrypt', 'tinyauthtinyauthtinyau', ident='2b') | replace('$', '$$') }}{% if user.totp is defined %}:{{ user.totp }}{% endif %}{% if not loop.last %},{% endif %}{% endfor %}'
{% for user in vault_tinyauth_users if user.email is defined %}
      # The address apps get for this user (Immich matches accounts by it); without one Tinyauth makes <name>@<private domain>.
      TINYAUTH_AUTH_USERATTRIBUTES_{{ user.name | upper }}_EMAIL: {{ user.email | to_json }}
{% endfor %}
{% if tinyauth_oauth_enabled | bool %}
      # A GitHub or Google login is limited by email, not by user name: the people in vault_tinyauth_users who have one.
      TINYAUTH_OAUTH_WHITELIST: {{ vault_tinyauth_users | selectattr('email', 'defined') | map(attribute='email') | join(',') | to_json }}
{% endif %}
      # No Docker socket: per-app rules come from service_users below, not from container labels.
      TINYAUTH_LABELPROVIDER: none
      TINYAUTH_ANALYTICS_ENABLED: "false"
{% set limited = protected_service_keys | select('in', service_users.keys() | list) | select('in', enabled_service_keys) | list %}
{% if limited | length > 0 %}
      # Tinyauth finds the service by its exact name (CONFIG_DOMAIN), and an app id may not contain an underscore, so it is
      # the key with dashes.
{% for key in limited %}
      TINYAUTH_APPS_{{ key | upper | replace('_', '-') }}_CONFIG_DOMAIN: "{{ lookup('ansible.builtin.vars', key ~ '_subdomain') }}.{{ caddy_private_domains[0] }}"
      TINYAUTH_APPS_{{ key | upper | replace('_', '-') }}_USERS_ALLOW: "{{ service_users[key] | join(',') | replace('$', '$$') }}"
{% if tinyauth_oauth_enabled | bool %}
      TINYAUTH_APPS_{{ key | upper | replace('_', '-') }}_OAUTH_WHITELIST: {{ vault_tinyauth_users | selectattr('name', 'in', service_users[key]) | map(attribute='email') | join(',') | to_json }}
{% endif %}
{% endfor %}
{% endif %}
{% for name, value in tinyauth_environment.items() %}
      {{ name }}: {{ (value | string | replace('$', '$$')) | to_json }}
{% endfor %}
{% if oidc_service_keys | length > 0 %}
      # The apps that sign in through Tinyauth instead of only their own login
      # (docs/auth-reference.md#sign-in-with-tinyauth-oidc). Declaring a client here is what starts Tinyauth's OpenID
      # Connect server. The redirect URIs must match the app's exactly (oidc in services.yml).
{% for app in services | selectattr('key', 'in', oidc_service_keys) %}
      TINYAUTH_OIDC_CLIENTS_{{ app.key | upper }}_CLIENTID: "{{ app.key }}"
      TINYAUTH_OIDC_CLIENTS_{{ app.key | upper }}_CLIENTSECRET: '{{ lookup('ansible.builtin.vars', app.oidc_secret) | replace("$", "$$") }}'
      TINYAUTH_OIDC_CLIENTS_{{ app.key | upper }}_TRUSTEDREDIRECTURIS: "{{ app.oidc | join(',') }}"
      TINYAUTH_OIDC_CLIENTS_{{ app.key | upper }}_NAME: "{{ app.name }}"
{% endfor %}
{% endif %}
    networks:
      - {{ docker_network }}
