# Ansible-managed — do not edit directly, edit the tinyauth_* settings and re-deploy.
# The login page for the web services behind Tinyauth (docs/services.md#tinyauth-login). The compose file is
# mode 0640 because it holds the users' password hashes; `$` is written `$$` because compose would read it as a variable.
networks:
  {{ docker_network }}:
    external: true

services:
  tinyauth:
    image: {{ tinyauth_image }}
    container_name: tinyauth
    restart: unless-stopped
{% if tinyauth_port != '' %}
    ports:
      - "{{ tinyauth_port }}:3000"
{% endif %}
    volumes:
      # The session database. Without it every container recreate logs everyone out.
      - {{ tinyauth_data_dir }}:/data
    environment:
      TZ: {{ timezone }}
      # The login page's own address. The session cookie is set for its parent domain, so every protected service
      # must be a name under the same private domain.
      TINYAUTH_APPURL: "https://{{ tinyauth_subdomain }}.{{ caddy_private_domains[0] }}"
      # name:bcrypt-hash[:totp-secret], separated by commas. Tinyauth wants a hash, so the vault passwords are hashed here
      # (a fixed salt keeps the output the same on every run, as for ntfy and Garage).
      TINYAUTH_AUTH_USERS: '{% for user in vault_tinyauth_users %}{{ user.name }}:{{ user.password | password_hash('bcrypt', 'tinyauthtinyauthtinyau', ident='2b') | replace('$', '$$') }}{% if user.totp is defined %}:{{ user.totp }}{% endif %}{% if not loop.last %},{% endif %}{% endfor %}'
      # No Docker socket: per-app rules are not used, own_login in services.yml decides what is protected.
      TINYAUTH_LABELPROVIDER: none
      TINYAUTH_ANALYTICS_ENABLED: "false"
{% for name, value in tinyauth_environment.items() %}
      {{ name }}: {{ (value | string | replace('$', '$$')) | to_json }}
{% endfor %}
{% if gitea_sso_enabled | bool or immich_sso_enabled | bool %}
      # The apps that sign in through Tinyauth instead of only their own login
      # (docs/auth-reference.md#sign-in-with-tinyauth-oidc). Declaring a client here is what starts Tinyauth's OpenID
      # Connect server. The redirect URIs must match the app's exactly, and the client id is part of the account id the
      # app stores, so changing it orphans every linked account.
{% endif %}
{% if gitea_sso_enabled | bool %}
      TINYAUTH_OIDC_CLIENTS_GITEA_CLIENTID: "gitea"
      TINYAUTH_OIDC_CLIENTS_GITEA_CLIENTSECRET: '{{ vault_gitea_oidc_secret | replace("$", "$$") }}'
      TINYAUTH_OIDC_CLIENTS_GITEA_TRUSTEDREDIRECTURIS: "https://{{ gitea_domain }}/user/oauth2/tinyauth/callback"
      TINYAUTH_OIDC_CLIENTS_GITEA_NAME: "Gitea"
{% endif %}
{% if immich_sso_enabled | bool %}
      TINYAUTH_OIDC_CLIENTS_IMMICH_CLIENTID: "immich"
      TINYAUTH_OIDC_CLIENTS_IMMICH_CLIENTSECRET: '{{ vault_immich_oidc_secret | replace("$", "$$") }}'
      # Immich's web login, its "link OAuth" page in the user settings, and the phone apps' fixed callback.
      TINYAUTH_OIDC_CLIENTS_IMMICH_TRUSTEDREDIRECTURIS: "https://{{ immich_subdomain }}.{{ caddy_private_domains[0] }}/auth/login,https://{{ immich_subdomain }}.{{ caddy_private_domains[0] }}/user-settings,app.immich:///oauth-callback"
      TINYAUTH_OIDC_CLIENTS_IMMICH_NAME: "Immich"
{% endif %}
    networks:
      - {{ docker_network }}
