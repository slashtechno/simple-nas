# Ansible-managed — do not edit directly, edit vars.yml/vault.yml and re-deploy.
networks:
  {{ docker_network }}:
    external: true

services:
  gitea:
    image: {{ gitea_image }}
    container_name: gitea
    restart: unless-stopped
    volumes:
      - {{ gitea_data_dir }}:/data
    environment:
      TZ: {{ timezone }}
      # Must be the uid and gid of ansible_user, who owns the data directories (tasks/main.yml).
      USER_UID: 1000
      USER_GID: 1000
      GITEA__server__ROOT_URL: {{ gitea_root_url }}
      GITEA__server__DOMAIN: {{ gitea_domain }}
      GITEA__server__SSH_DOMAIN: {{ gitea_ssh_domain }}
      GITEA__server__SSH_PORT: "{{ gitea_ssh_port }}"
      GITEA__database__DB_TYPE: sqlite3
      GITEA__database__PATH: /data/gitea/gitea.db
      GITEA__service__DISABLE_REGISTRATION: "true"
      # Hides the "Sign in with OpenID" button: Gitea's own OpenID 2.0 login, a different protocol from Tinyauth's.
      GITEA__openid__ENABLE_OPENID_SIGNIN: "false"
{% if gitea_sso_enabled | bool %}
      # Signing in through the Tinyauth login source, which the deploy adds to the database once this container runs.
      # With auto-registration off, a first login goes to Gitea's link page, where the user attaches it to their
      # existing account; the password form stays (docs/auth-reference.md#sign-in-with-tinyauth-oidc). The scopes are
      # needed for the email claim: without them Gitea asks only for "openid" and Tinyauth sends no address.
      GITEA__oauth2_client__ENABLE_AUTO_REGISTRATION: "false"
      GITEA__oauth2_client__OPENID_CONNECT_SCOPES: "openid email profile"
{% endif %}
{% if vault_gitea_runner_token | default("") %}
      GITEA_RUNNER_REGISTRATION_TOKEN: '{{ vault_gitea_runner_token | replace("$", "$$") }}'
{% endif %}
    ports:
      - "{{ gitea_ssh_port }}:22"
{% if gitea_port != '' %}
      - "{{ gitea_port }}:3000"
{% endif %}
    networks:
      - {{ docker_network }}

{% if vault_gitea_runner_token | default("") %}
  gitea-runner:
    image: {{ gitea_runner_image }}
    container_name: gitea-runner
    restart: unless-stopped
    environment:
      GITEA_INSTANCE_URL: "http://gitea:3000"
      GITEA_RUNNER_REGISTRATION_TOKEN: '{{ vault_gitea_runner_token | replace("$", "$$") }}'
      GITEA_RUNNER_NAME: "{{ inventory_hostname }}-runner"
      GITEA_RUNNER_EPHEMERAL: "1"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - {{ gitea_runner_data_dir }}:/data
    networks:
      - {{ docker_network }}
    depends_on:
      - gitea
{% endif %}
