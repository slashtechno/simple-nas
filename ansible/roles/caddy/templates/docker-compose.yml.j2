# Ansible-managed — do not edit directly, edit the settings and re-deploy.
# caddy-docker-proxy builds its Caddyfile from the labels of containers on the {{ docker_network }} network;
# the label syntax is in docs/caddy-reference.md. It has the Docker socket, like Dockge.
networks:
  {{ docker_network }}:
    external: true

services:
  caddy:
    build:
      context: .
      args:
        CADDY_VERSION: {{ caddy_version }}
        CADDY_DOCKER_PROXY_VERSION: {{ caddy_docker_proxy_version }}
        CADDY_CLOUDFLARE_DNS_VERSION: {{ caddy_cloudflare_dns_version }}
    container_name: caddy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443/tcp"
      - "443:443/udp"
    environment:
      CADDY_INGRESS_NETWORKS: {{ docker_network }}
{% if caddy_private_domains | length > 0 %}
      CLOUDFLARE_API_TOKEN: "{{ cloudflare_api_token }}"
{% endif %}
{% if caddy_private_domains | length > 0 or caddy_sites | length > 0 %}
    labels:
{% set site = namespace(n=0) %}
{% if caddy_private_domains | length > 0 %}
      # A global option: every site Caddy serves gets its certificate through the Cloudflare DNS challenge.
      caddy.acme_dns: cloudflare {env.CLOUDFLARE_API_TOKEN}
{% if tinyauth_enabled | bool %}
      # A snippet: a site that imports it sends each request to Tinyauth first and passes the user on as headers.
      # Ad-hoc apps in Dockge opt in with one label: caddy.import: tinyauth_forwarder
      caddy_{{ site.n }}: (tinyauth_forwarder)
      caddy_{{ site.n }}.forward_auth: tinyauth:3000
      caddy_{{ site.n }}.forward_auth.uri: /api/auth/caddy
      caddy_{{ site.n }}.forward_auth.copy_headers: Remote-User Remote-Name Remote-Email Remote-Groups
{% set site.n = site.n + 1 %}
{% endif %}
      # One site per service this host runs (web_services, group_vars/all/services.yml), unless its subdomain is "".
{% for web in caddy_web_sites %}
      caddy_{{ site.n }}: "{{ web.hosts }}"
{% if web.protected | bool %}
      caddy_{{ site.n }}.import: tinyauth_forwarder
{% endif %}
      caddy_{{ site.n }}.reverse_proxy: "{{ web.scheme }}://{{ web.container }}:{{ web.container_port }}"
{% if web.scheme == 'https' %}
      caddy_{{ site.n }}.reverse_proxy.transport: http
      caddy_{{ site.n }}.reverse_proxy.transport.tls_insecure_skip_verify: ""
{% endif %}
{% set site.n = site.n + 1 %}
{% endfor %}
{% endif %}
{% for address, directives in caddy_sites.items() %}
      caddy_{{ site.n }}: "{{ address }}"
{% for directive, value in directives.items() %}
      caddy_{{ site.n }}.{{ directive }}: {{ value | to_json }}
{% endfor %}
{% set site.n = site.n + 1 %}
{% endfor %}
{% if caddy_private_domains | length > 0 %}
      # Short name: http://{{ inventory_hostname }}, which MagicDNS resolves here, redirects to the first private domain.
      caddy_{{ site.n }}: "http://{{ inventory_hostname }}"
      caddy_{{ site.n }}.redir: "https://{{ caddy_private_domains[0] }}{uri}"
{% set site.n = site.n + 1 %}
{% endif %}
{% endif %}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - {{ caddy_data_dir }}:/data
    networks:
      - {{ docker_network }}
