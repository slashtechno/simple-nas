# Ansible-managed — do not edit directly, edit the settings and re-deploy.
# caddy-docker-proxy builds its Caddyfile from the labels of containers on the {{ docker_network }} network;
# the label syntax is in docs/caddy-reference.md. It has the Docker socket, like Dockge.
networks:
  {{ docker_network }}:
    external: true

services:
  caddy:
    build:
      context: .
      args:
        CADDY_VERSION: {{ caddy_version }}
        CADDY_DOCKER_PROXY_VERSION: {{ caddy_docker_proxy_version }}
        CADDY_CLOUDFLARE_DNS_VERSION: {{ caddy_cloudflare_dns_version }}
    container_name: caddy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443/tcp"
      - "443:443/udp"
    environment:
      CADDY_INGRESS_NETWORKS: {{ docker_network }}
{% if caddy_private_domains | length > 0 %}
      CLOUDFLARE_API_TOKEN: "{{ cloudflare_api_token }}"
{% endif %}
{% if caddy_private_domains | length > 0 or caddy_sites | length > 0 %}
    labels:
{% set site = namespace(n=0) %}
{% if caddy_private_domains | length > 0 %}
      # A global option: every site Caddy serves gets its certificate through the Cloudflare DNS challenge.
      caddy.acme_dns: cloudflare {env.CLOUDFLARE_API_TOKEN}
      # One site per service this host runs (web_services, group_vars/all/web_services.yml), unless its subdomain is "".
{% for svc in web_services if svc.port is not defined and hostvars[inventory_hostname][svc.key ~ '_enabled'] | bool and hostvars[inventory_hostname][svc.key ~ '_subdomain'] != '' %}
      caddy_{{ site.n }}: "{% for domain in caddy_private_domains %}{{ hostvars[inventory_hostname][svc.key ~ '_subdomain'] }}.{{ domain }}{{ ' ' if not loop.last }}{% endfor %}"
      caddy_{{ site.n }}.reverse_proxy: "{{ svc.scheme | default('http') }}://{{ svc.container }}:{{ svc.container_port }}"
{% if svc.scheme | default('http') == 'https' %}
      caddy_{{ site.n }}.reverse_proxy.transport: http
      caddy_{{ site.n }}.reverse_proxy.transport.tls_insecure_skip_verify: ""
{% endif %}
{% set site.n = site.n + 1 %}
{% endfor %}
{% endif %}
{% for address, upstream in caddy_sites.items() %}
      caddy_{{ site.n }}: "{{ address }}"
      caddy_{{ site.n }}.reverse_proxy: "{{ upstream }}"
{% set site.n = site.n + 1 %}
{% endfor %}
{% if caddy_private_domains | length > 0 %}
      # Short names: http://{{ inventory_hostname }} and http://<app>.{{ inventory_hostname }}, which MagicDNS and a tailnet search domain resolve here, redirect to the first private domain.
      caddy_{{ site.n }}: "http://{{ inventory_hostname }}"
      caddy_{{ site.n }}.redir: "https://{{ caddy_private_domains[0] }}{uri}"
      caddy_{{ site.n + 1 }}: "http://*.{{ inventory_hostname }}"
      caddy_{{ site.n + 1 }}.redir: "https://{labels.1}.{{ caddy_private_domains[0] }}{uri}"
{% set site.n = site.n + 2 %}
{% endif %}
{% endif %}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - {{ caddy_data_dir }}:/data
    networks:
      - {{ docker_network }}
