networks:
  {{ docker_network }}:
    external: true

services:
  pics:
    build: ./src/local/pics
    image: pics-hub
    container_name: pics
    restart: unless-stopped
    read_only: true
    tmpfs:
      - /tmp
    env_file: pics.env
    volumes:
      - {{ pics_data_dir }}:/data
    # Only the owner app is published: LAN + tailnet. The guest
    # surface (:{{ pics_public_port }}) stays on the docker network, reachable only by cloudflared.
    ports:
      - "{{ pics_port }}:8000"
    networks:
      - {{ docker_network }}
