networks:
  {{ nas_network }}:
    external: true

services:
  pics:
    build: ./src/local/pics
    image: pics-hub
    container_name: pics
    restart: unless-stopped
    read_only: true
    tmpfs:
      - /tmp
    env_file: pics.env
    volumes:
      - {{ pics_data_dir }}:/data
    ports:
      - "{{ pics_port }}:8000"
    networks:
      - {{ nas_network }}
