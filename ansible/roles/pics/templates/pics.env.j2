# Ansible-managed — do not edit directly, edit vars.yml/vault.yml and re-deploy.
# Single quotes stop docker compose from interpolating "$" in a value
COPYPARTY_URL='http://copyparty:3923'
# The login is the vault_copyparty_accounts entry named pics, and the two folders are the copyparty_folders pics-photos and pics-trash.
COPYPARTY_PASSWORD='{{ vault_pics_copyparty_password }}'
COPYPARTY_ROOT='/pics-photos'
COPYPARTY_TRASH_ROOT='/pics-trash'
HUB_PASSWORD='{{ vault_pics_password }}'
HUB_SECRET_KEY='{{ vault_pics_secret_key }}'
HUB_PUBLIC_URL='{{ pics_public_url }}'
HUB_PUBLIC_PORT='{{ pics_public_port }}'
{% if pics_sso_enabled | bool %}
# Sign in through Tinyauth (docs/auth-reference.md#sign-in-with-tinyauth-oidc). The pics container reaches the issuer
# by the Caddy container's network alias for the login page. The callback is the address the browser opened pics on.
HUB_OIDC_ISSUER='{{ tinyauth_url }}'
HUB_OIDC_CLIENT_ID='pics'
HUB_OIDC_CLIENT_SECRET='{{ vault_pics_oidc_secret }}'
HUB_OIDC_USERS='{{ service_users.pics | join(" ") }}'
{% endif %}
{% if pics_artist %}
HUB_ARTIST='{{ pics_artist }}'
{% endif %}
{% if pics_links | length > 0 %}
HUB_LINKS='{{ pics_links | to_json }}'
{% endif %}
{% if alert_targets.pics.url | length > 0 %}
# The alert address in Apprise's syntax: http://host:8090/alerts + a token becomes ntfy://<token>@host:8090/alerts (ntfys:// for https)
HUB_ALERT_URLS='{{ 'ntfys' if alert_targets.pics.url | urlsplit('scheme') == 'https' else 'ntfy' }}://{{ alert_targets.pics.token ~ '@' if alert_targets.pics.token | length > 0 else '' }}{{ alert_targets.pics.url | urlsplit('netloc') }}{{ alert_targets.pics.url | urlsplit('path') }}'
{% endif %}
