# Ansible-managed — do not edit directly, edit vars.yml/vault.yml and re-deploy.
# Single quotes stop docker compose from interpolating "$" in a value
COPYPARTY_URL='http://copyparty:3923'
# The account and volumes are pics' copyparty entry in services.yml: the account is named pics, its volumes are
# served at /apps/pics/photos and /apps/pics/trash.
COPYPARTY_PASSWORD='{{ vault_pics_copyparty_password }}'
COPYPARTY_ROOT='/apps/pics/photos'
COPYPARTY_TRASH_ROOT='/apps/pics/trash'
HUB_PASSWORD='{{ vault_pics_password }}'
HUB_SECRET_KEY='{{ vault_pics_secret_key }}'
HUB_PUBLIC_URL='{{ pics_public_url }}'
HUB_PUBLIC_PORT='{{ pics_public_port }}'
{% if pics_sso_enabled | bool %}
# Sign in through Tinyauth (docs/auth-reference.md#sign-in-with-tinyauth-oidc). The pics container reaches the issuer
# by the Caddy container's network alias for the login page.
HUB_OIDC_ISSUER='https://{{ tinyauth_subdomain }}.{{ caddy_private_domains[0] }}'
HUB_OIDC_CLIENT_ID='pics'
HUB_OIDC_CLIENT_SECRET='{{ vault_pics_oidc_secret }}'
HUB_OIDC_REDIRECT_URL='https://{{ pics_subdomain }}.{{ caddy_private_domains[0] }}/api/auth/oidc/callback'
HUB_OIDC_OWNER='{{ pics_oidc_owner }}'
{% endif %}
{% if pics_artist %}
HUB_ARTIST='{{ pics_artist }}'
{% endif %}
{% if pics_website %}
HUB_WEBSITE='{{ pics_website }}'
{% endif %}
{% if pics_instagram %}
HUB_INSTAGRAM='{{ pics_instagram }}'
{% endif %}
{% if vault_pics_alert_urls | length > 0 %}
HUB_ALERT_URLS='{{ vault_pics_alert_urls }}'
{% endif %}
