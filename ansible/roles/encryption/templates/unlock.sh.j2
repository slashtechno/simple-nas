#!/bin/bash
# Ansible-managed (roles/encryption). Run after every boot: sudo {{ scripts_dir }}/unlock.sh
# Asks for the passphrase once (only if a folder is locked) and mounts each encrypted folder. If it mounted any, it
# runs every *.sh in {{ encryption_hooks_dir }}, in name order (docs/encryption.md). The deploy installs 00-docker.sh
# there; your own start commands go beside it.
# The passphrase can also arrive on stdin (`printf %s "$PASS" | sudo unlock.sh`), so another program can run this script.
set -euo pipefail

PASS=""
MOUNTED=0

# Asked at the first locked folder, so an unlocked host never prompts.
ask_passphrase() {
  if [ -z "$PASS" ]; then
    # Input from a pipe without a final newline still sets PASS, but read returns failure.
    IFS= read -rsp "gocryptfs passphrase: " PASS || true
    echo
    if [ -z "$PASS" ]; then
      echo "ERROR: no passphrase given." >&2
      exit 1
    fi
  fi
}

# Software that started while a folder was locked still sees it empty. After mounting, the scripts restart it.
# This runs when the script ends, even when a later folder fails, so folders mounted before the failure do not
# leave stale software behind. A loop over *.sh, not run-parts, for the reason in backup-services.sh. A script that
# fails does not stop the others, and the unlock then exits with an error.
finish() {
  local status=$?
  if [ "$MOUNTED" = 1 ]; then
    shopt -s nullglob
    for script in {{ encryption_hooks_dir | quote }}/*.sh; do
      echo "Running $(basename "$script")"
      if ! bash "$script"; then
        echo "ERROR: $(basename "$script") failed." >&2
        [ "$status" = 0 ] && status=1
      fi
    done
  fi
  exit "$status"
}
trap finish EXIT

{% for folder in encrypted_pairs %}
# --- {{ folder.mount }} ---
# gocryptfs writes gocryptfs.conf as root with mode 0400 (at init, and again at every -passwd), so the backup user could
# not read it and every backup would fail on it. The backups keep the conf (docs/encryption.md), so give it to
# {{ ansible_user }}, who runs them. Done on every run, mounted or not, so running this after a -passwd repairs it.
if [ -e {{ (folder.cipher ~ '/gocryptfs.conf') | quote }} ]; then
  chown {{ ansible_user | quote }} {{ (folder.cipher ~ '/gocryptfs.conf') | quote }}
fi
if ! mountpoint -q {{ (folder.mount ~ '/.') | quote }}; then
  # Checked before the prompt, so a folder that was never set up, or whose drive is not mounted, says so.
  if [ ! -d {{ folder.cipher | quote }} ]; then
    echo "ERROR: {{ folder.cipher }} does not exist, so {{ folder.mount }} was never set up. Run init-encrypted-folder.sh (docs/encryption.md#set-up-a-folder)." >&2
    exit 1
  fi
  if [ ! -d {{ folder.mount | quote }} ]; then
    echo "ERROR: {{ folder.mount }} does not exist. Is {{ folder.mount | dirname }} mounted?" >&2
    exit 1
  fi
  ask_passphrase
  echo "Unlocking {{ folder.mount }}"
  # The folder must be empty: files left in it would be hidden by the mount. Move them away first (docs/encryption.md).
  if [ -n "$(ls -A {{ folder.mount | quote }})" ]; then
    echo "ERROR: {{ folder.mount }} is not empty. Move its files away, then run this again (docs/encryption.md)." >&2
    exit 1
  fi
  # While locked, the empty folder is immutable: nothing can be created in it, so a container or a deploy that
  # runs before the unlock fails with "Operation not permitted" instead of filling the drive underneath.
  # The flag stays on the folder across reboots (to remove it: chattr -i) and does not touch the decrypted files.
  # Not every filesystem supports it (it needs ext4, xfs or btrfs), so warn rather than refuse to mount the folder.
  if ! chattr +i {{ folder.mount | quote }}; then
    echo "WARNING: {{ folder.mount }} does not support the immutable flag, so nothing stops plain files being written into it while it is locked (docs/encryption.md)." >&2
  fi
  # -allow_other lets containers, which run as other user ids, read the files. Never -nonempty.
  gocryptfs -allow_other {{ folder.cipher | quote }} {{ folder.mount | quote }} <<<"$PASS" >/dev/null
  MOUNTED=1
fi
{% endfor %}

if [ "$MOUNTED" = 0 ]; then
  echo "Already unlocked."
fi
