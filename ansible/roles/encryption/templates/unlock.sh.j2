#!/bin/bash
# Ansible-managed (roles/encryption). Run after every boot: sudo {{ scripts_dir }}/unlock.sh   (--status: show what is locked)
# --lock stops the containers that use the folders and unmounts them (the next unlock starts those again).
# --alert, run by cron, sends an alert while a folder is locked (docs/encryption.md#alert-while-locked).
# Asks for the passphrase once (only if a folder is locked) and mounts each encrypted folder. If it mounted any, it
# runs every *.sh in {{ encryption_hooks_dir }}, in name order, giving each the folders it mounted (docs/encryption.md).
# The deploy installs 00-containers.sh there; your own start commands go beside it.
# The passphrase can also arrive on stdin (`printf %s "$PASS" | sudo unlock.sh`), so another program can run this script.
# No -e: a folder that fails must not stop the others, so each step is checked where it can fail.
set -uo pipefail

PASS=""
MOUNTED=()   # the folders this run mounted
FAILED=0
LOCKED=()    # --status, --alert: the folders that are locked
MISSING=()   # --alert: the folders with no encrypted files (never set up, or the drive is not mounted)

# Asked at the first locked folder, so an unlocked host never prompts.
ask_passphrase() {
  if [ -z "$PASS" ]; then
    # Input from a pipe without a final newline still sets PASS, but read returns failure.
    IFS= read -rsp "gocryptfs passphrase: " PASS || true
    echo
    if [ -z "$PASS" ]; then
      echo "ERROR: no passphrase given." >&2
      exit 1
    fi
  fi
}

# One line per folder: unlocked, locked, or no encrypted files found.
show_state() {
  local mount=$1 cipher=$2
  # The trailing "/." is the idiom of the backup guards (roles/backup/templates/mount-guards.j2): mountpoint -q on the bare
  # path can succeed on the automount placeholder of a missing drive.
  if mountpoint -q "$mount/."; then
    echo "unlocked      $mount"
  elif [ ! -d "$cipher" ]; then
    echo "no files      $mount ($cipher does not exist: never set up, or its drive is not mounted)"
    MISSING+=("$mount")
  else
    echo "LOCKED        $mount"
    LOCKED+=("$mount")
  fi
}

# Only these three are accepted: whatever calls this, the unlock page's request script included, cannot make it do anything else.
case "${1:-}" in
  "" | --status | --lock | --alert) ;;
  *) echo "usage: unlock.sh [--status | --lock]" >&2; exit 2 ;;
esac

if [ "${1:-}" = "--lock" ]; then
  MOUNTED_NOW=()
{% for folder in encrypted_pairs %}
  mountpoint -q {{ (folder.mount ~ '/.') | quote }} && MOUNTED_NOW+=({{ folder.mount | quote }})
{% endfor %}
  if [ -z "${MOUNTED_NOW[*]:-}" ]; then echo "Already locked."; exit 0; fi
  # A backup reads these folders. Unmounting under it makes files vanish, and restic would save a snapshot without them.
  # The backup scripts hold the same lock on this folder (roles/backup, mount-guards.j2). The lock ends with this script.
  exec 9<{{ scripts_dir | quote }}
  flock -n 9 || { echo "A backup is running. Lock again when it finishes." >&2; exit 1; }
  if [ -x {{ (encryption_hooks_dir ~ '/00-containers.sh') | quote }} ]; then
    {{ (encryption_hooks_dir ~ '/00-containers.sh') | quote }} --stop "${MOUNTED_NOW[@]}" || FAILED=1
  fi
  for mount in "${MOUNTED_NOW[@]}"; do
    if umount "$mount"; then
      echo "Locked $mount"
    else
      echo "ERROR: could not unmount $mount: something still has a file open there (fuser -vm $mount)." >&2
      FAILED=1
    fi
  done
  [ "$FAILED" = 0 ] || echo "The containers stopped for the lock stay stopped. Close what holds the folder and lock again, or unlock to start them." >&2
  exit "$FAILED"
fi

if [ "${1:-}" = "--alert" ]; then
{% for folder in encrypted_pairs %}
  show_state {{ folder.mount | quote }} {{ folder.cipher | quote }} >/dev/null
{% endfor %}
  [ -n "${LOCKED[*]:-}${MISSING[*]:-}" ] || exit 0
  HOW={{ (('Unlock at https://' ~ unlock_page_subdomain ~ '.' ~ caddy_private_domains[0]) if unlock_page_enabled | bool else ('Run on the host: sudo ' ~ scripts_dir ~ '/unlock.sh')) | quote }}
  MESSAGE=""
  [ -z "${LOCKED[*]:-}" ] || MESSAGE="Locked, waiting for the passphrase: ${LOCKED[*]}. "
  [ -z "${MISSING[*]:-}" ] || MESSAGE="${MESSAGE}No encrypted files found (the drive is not mounted, or it was never set up): ${MISSING[*]}. "
  # alert.sh logs the message and sends it to ntfy when host_alert_url is set (roles/common).
  exec {{ (scripts_dir ~ '/alert.sh') | quote }} "${MESSAGE}Containers that use them stay down. $HOW" unlock "encrypted folders need attention"
fi

if [ "${1:-}" = "--status" ]; then
{% for folder in encrypted_pairs %}
  show_state {{ folder.mount | quote }} {{ folder.cipher | quote }}
{% endfor %}
  if [ -n "${LOCKED[*]:-}" ] && [ -x {{ (encryption_hooks_dir ~ '/00-containers.sh') | quote }} ]; then
    echo "Containers that use a locked folder (restarted or started when it unlocks):"
    {{ (encryption_hooks_dir ~ '/00-containers.sh') | quote }} -n "${LOCKED[@]}"
  fi
  exit 0
fi

# Software that started while a folder was locked still sees it empty. After mounting, the scripts restart it. This
# runs when the script ends, even when a later folder fails, so folders mounted before the failure do not leave stale
# software behind. Each script gets the mounted folders as arguments. A loop over *.sh, not run-parts: run-parts skips names with a dot, such as
# my.start.sh. A script that fails does not stop the others, and the unlock then exits with an error.
finish() {
  local status=$?
  if [ -n "${MOUNTED[*]:-}" ]; then
    shopt -s nullglob
    for script in {{ encryption_hooks_dir | quote }}/*.sh; do
      echo "Running $(basename "$script")"
      if ! bash "$script" "${MOUNTED[@]}"; then
        echo "ERROR: $(basename "$script") failed." >&2
        [ "$status" = 0 ] && status=1
      fi
    done
  elif [ -s {{ encryption_stopped_file | quote }} ]; then
    # A lock that failed on a busy folder stopped containers and left the folder mounted. Nothing is mounted by this run, but they must start.
    bash {{ (encryption_hooks_dir ~ '/00-containers.sh') | quote }} || status=1
  fi
  exit "$status"
}
trap finish EXIT

# Returns 1 for a folder that cannot be unlocked (the others carry on). Exits for a wrong or missing passphrase,
# which would fail every folder.
unlock_folder() {
  local mount=$1 cipher=$2 rc
  # gocryptfs writes gocryptfs.conf as root with mode 0400 (at init, and again at every -passwd), so the backup user could
  # not read it and every backup would fail on it. The backups keep the conf (docs/encryption.md), so give it to
  # {{ ansible_user }}, who runs them. Done on every run, mounted or not, so running this after a -passwd repairs it.
  if [ -e "$cipher/gocryptfs.conf" ]; then
    chown {{ ansible_user | quote }} "$cipher/gocryptfs.conf" || echo "WARNING: could not give $cipher/gocryptfs.conf to {{ ansible_user }}, so backups cannot read it." >&2
  fi
  mountpoint -q "$mount/." && return 0
  # Checked before the prompt, so a folder that was never set up, or whose drive is not mounted, says so.
  if [ ! -d "$cipher" ]; then
    echo "ERROR: $cipher does not exist. Either $mount was never set up (docs/encryption.md#set-up-a-folder) or its drive is not mounted." >&2
    return 1
  fi
  if [ ! -d "$mount" ]; then
    echo "ERROR: $mount does not exist. Is $(dirname "$mount") mounted?" >&2
    return 1
  fi
  ask_passphrase
  echo "Unlocking $mount"
  # The folder must be empty: files left in it would be hidden by the mount. Move them away first (docs/encryption.md).
  if [ -n "$(ls -A "$mount")" ]; then
    echo "ERROR: $mount is not empty. Move its files away, then run this again (docs/encryption.md)." >&2
    return 1
  fi
  # While locked, the empty folder is immutable: nothing can be created in it, so a container or a deploy that
  # runs before the unlock fails with "Operation not permitted" instead of filling the drive underneath.
  # The flag stays on the folder across reboots (to remove it: chattr -i) and does not touch the decrypted files.
  # Not every filesystem supports it (it needs ext4, xfs or btrfs), so warn rather than refuse to mount the folder.
  if ! chattr +i "$mount"; then
    echo "WARNING: $mount does not support the immutable flag, so nothing stops plain files being written into it while it is locked (docs/encryption.md)." >&2
  fi
  # -allow_other lets containers, which run as other user ids, read the files. Never -nonempty.
  gocryptfs -allow_other "$cipher" "$mount" <<<"$PASS" >/dev/null
  rc=$?
  if [ "$rc" = 12 ]; then
    echo "ERROR: wrong passphrase for $mount." >&2
    exit 12
  elif [ "$rc" != 0 ]; then
    echo "ERROR: gocryptfs failed on $mount (exit $rc)." >&2
    return 1
  fi
  MOUNTED+=("$mount")
}

{% for folder in encrypted_pairs %}
unlock_folder {{ folder.mount | quote }} {{ folder.cipher | quote }} || FAILED=1
{% endfor %}

if [ -z "${MOUNTED[*]:-}" ] && [ "$FAILED" = 0 ]; then
  echo "Already unlocked."
fi
exit "$FAILED"
