#!/bin/bash
# Ansible-managed (roles/encryption). Run after every boot: sudo {{ scripts_dir }}/unlock.sh
# Asks for the passphrase once and mounts each encrypted folder, then restarts Docker.
set -euo pipefail

read -rsp "gocryptfs passphrase: " PASS
echo

{% for folder in encrypted_pairs %}
# --- {{ folder.mount }} ---
if ! mountpoint -q {{ (folder.mount ~ '/.') | quote }}; then
  # While locked, the empty folder is made immutable: nothing can write into it, so a container or a deploy
  # that runs before the unlock fails with "Operation not permitted" instead of filling the drive underneath.
  # The flag stays on the folder across reboots and does not touch the decrypted files.
  chattr +i {{ folder.mount | quote }}
  # -allow_other lets containers, which run as other user ids, read the files. Never -nonempty: if something
  # got into the folder anyway, the mount fails instead of hiding it.
  gocryptfs -allow_other {{ folder.cipher | quote }} {{ folder.mount | quote }} <<<"$PASS" >/dev/null
fi
{% endfor %}

# A container that started while a folder was locked still sees the empty folder; a restart shows the files.
systemctl restart docker
echo "Unlocked. Docker restarted."
