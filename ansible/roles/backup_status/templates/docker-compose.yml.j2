networks:
  {{ docker_network }}:
    external: true

{# Host-side values the page needs to build the SSH commands it shows. to_json twice makes a quoted YAML string. #}
{% set host_config = {
  "sshUser": ansible_user,
  "backupDrive": backup_drive,
  "cloudEnabled": backup_cloud_enabled | bool,
  "resticRepoPath": restic_repo_path,
  "resticPasswordFile": restic_password_file,
  "resticCloudRepository": restic_cloud_repository,
  "resticLocalRetention": restic_local_retention,
  "resticCloudRetention": restic_cloud_retention,
  "resticCloudRcloneArgs": restic_cloud_rclone_args,
  "scriptsDir": scripts_dir,
} %}

services:
  backup-status:
    build:
      context: .
      args:
        RESTIC_IMAGE: {{ restic_image }}
        PYTHON_IMAGE: {{ python_image }}
    container_name: backup-status
    restart: unless-stopped
    # Every mount is read-only, so the container cannot change or delete a backup.
    volumes:
      - {{ restic_repo_path }}:/data/restic-repo:ro
      - {{ backup_logs_dir }}:/data/logs:ro
      - {{ restic_password_file }}:/data/restic-password:ro
    environment:
      TZ: {{ timezone }}
      RESTIC_REPO_PATH: /data/restic-repo
      BACKUP_LOGS_DIR: /data/logs
      RESTIC_PASSWORD_FILE: /data/restic-password
      HOST_CONFIG: {{ host_config | to_json | replace('$', '$$') | to_json }}
{% if backup_status_port != '' %}
    ports:
      - "{{ backup_status_port }}:8080"
{% endif %}
    networks:
      - {{ docker_network }}
