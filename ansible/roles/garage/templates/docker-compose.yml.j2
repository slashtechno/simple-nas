# Ansible-managed — do not edit directly, edit vars.yml/vault.yml and re-deploy.
networks:
  {{ docker_network }}:
    external: true

services:
  garage:
    image: {{ garage_image }}
    container_name: garage
    restart: unless-stopped
    # Only injected on first deploy; see tasks/main.yml for why the flag must not be unconditional.
    command: ["/garage", "server"{% if garage_is_first_deploy | default(True) %}, "--single-node"{% endif %}]
    volumes:
      - {{ services_dir }}/garage/garage.toml:/etc/garage.toml:ro
      - {{ garage_data_dir }}/meta:/var/lib/garage/meta
      - {{ garage_data_dir }}/data:/var/lib/garage/data
    environment:
      GARAGE_CONFIG_FILE: /etc/garage.toml
    # No host ports: the S3 API goes through garage-cors-proxy, and the admin API and RPC stay on the Docker network.
    networks:
      - {{ docker_network }}

  garage-cors-proxy:
    image: {{ garage_caddy_image }}
    container_name: garage-cors-proxy
    restart: unless-stopped
    volumes:
      - {{ services_dir }}/garage/Caddyfile:/etc/caddy/Caddyfile:ro
    ports:
      - "{{ garage_s3_port }}:{{ garage_s3_port }}"
    networks:
      - {{ docker_network }}

  garage-webui:
    image: {{ garage_webui_image }}
    container_name: garage-webui
    restart: unless-stopped
    # No login and no host port: it is reached only through Caddy, behind Tinyauth (see tasks/main.yml).
    # webui reads garage.toml to discover the admin API and S3 settings
    volumes:
      - {{ services_dir }}/garage/garage.toml:/etc/garage.toml:ro
    environment:
      # Points at Garage's admin API and S3 API — both internal to the Docker network
      API_BASE_URL: "http://garage:3903"
      S3_ENDPOINT_URL: "http://garage:{{ garage_s3_port }}"
      CONFIG_PATH: /etc/garage.toml
      # Admin token for the v2 API — must match admin_token in garage.toml
      API_ADMIN_KEY: '{{ vault_garage_admin_token | replace("$", "$$") }}'
    networks:
      - {{ docker_network }}
