networks:
  {{ nas_network }}:
    external: true

services:
  backup-status:
    build:
      context: .
      args:
        RESTIC_IMAGE: {{ restic_image }}
        PYTHON_IMAGE: {{ backup_status_python_image }}
    container_name: backup-status
    restart: unless-stopped
    # Every mount is read-only, so the container cannot change or delete a backup.
    volumes:
      - {{ restic_repo_path }}:/data/restic-repo:ro
      - {{ backup_logs_dir }}:/data/logs:ro
      - {{ restic_password_file }}:/data/restic-password:ro
    environment:
      NAS_SSH_USER: "{{ ansible_user }}"
      RESTIC_REPO_PATH: /data/restic-repo
      BACKUP_LOGS_DIR: /data/logs
      RESTIC_PASSWORD_FILE: /data/restic-password
      HOST_BACKUP_DRIVE: "{{ backup_drive }}"
      HOST_RESTIC_REPO_PATH: "{{ restic_repo_path }}"
      HOST_RESTIC_PASSWORD_FILE: "{{ restic_password_file }}"
      HOST_RESTIC_CLOUD_REPOSITORY: "{{ restic_cloud_repository }}"
      HOST_RESTIC_LOCAL_RETENTION: "{{ restic_local_retention }}"
      HOST_RESTIC_CLOUD_RETENTION: "{{ restic_cloud_retention }}"
      HOST_RESTIC_CLOUD_RCLONE_ARGS: "{{ restic_cloud_rclone_args }}"
      HOST_SCRIPTS_DIR: "{{ nas_scripts_dir }}"
    ports:
      - "{{ backup_status_port }}:8080"
    networks:
      - {{ nas_network }}
