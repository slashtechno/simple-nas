# Ansible-managed — do not edit directly. The tunnel's rules are cloudflared_ingress in vars.yml.
networks:
  {{ docker_network }}:
    external: true

services:
  cloudflared:
    image: {{ cloudflared_image }}
    container_name: cloudflared
    restart: unless-stopped
    command: tunnel run --token-file /etc/cloudflared/token
    volumes:
      - {{ services_dir }}/cloudflared/token:/etc/cloudflared/token:ro
    networks:
      - {{ docker_network }}
