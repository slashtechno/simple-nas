ARG CLOUDFLARED_IMAGE
ARG ALPINE_IMAGE
FROM ${CLOUDFLARED_IMAGE} AS cloudflared
FROM ${ALPINE_IMAGE}

# Copy cloudflared binary from the official image
COPY --from=cloudflared /usr/local/bin/cloudflared /usr/local/bin/cloudflared

# Copy init script
COPY create_tunnel.sh /etc/cloudflared/create_tunnel.sh
RUN chmod -R 755 /etc/cloudflared

# Install curl, jq, and yq for API calls and YAML/JSON parsing
RUN apk add --no-cache curl jq yq

ENTRYPOINT ["/bin/sh"]
CMD ["/etc/cloudflared/create_tunnel.sh"]
