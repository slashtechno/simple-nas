# Managed by Ansible (network role). Hands the laptop on the direct link an address by DHCP: no DNS, no gateway.
# bind-dynamic, not bind-interfaces: with bind-interfaces dnsmasq fails at boot when the port has no link yet
# and stays dead; bind-dynamic attaches whenever the port appears.
interface={{ direct_link_iface }}
bind-dynamic
except-interface=lo
port=0
dhcp-range={{ direct_link_peer_ip }},{{ direct_link_peer_ip }},12h
# Without these two, dnsmasq advertises itself as the router and DNS server.
dhcp-option=3
dhcp-option=6
