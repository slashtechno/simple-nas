# Ansible-managed. Mounts USB drives and card readers that are not in `drives`.
# Skipped by UUID: every drive in `drives` and the root and boot filesystems. A wrong `uuid` in `drives`
# means that drive gets mounted a second time here. Upper and lower case are both skipped.
# ID_USB_INTERFACES, not ID_BUS: a USB-to-SATA bridge makes udev report ID_BUS=ata, and only a USB device has the former.
# add|change: a card put into a reader that is already plugged in sends only `change`. A repeat mount of a mounted device fails harmlessly.
# --fsck: a writable mount is checked first (exFAT has no journal). A read-only mount is not: `fsck -y` would write to a drive that is meant to stay untouched.
# nosuid,nodev,noexec: nothing on a plugged-in drive can run. ro: see usb_automount_writable.
{% set drive_uuids = mounted_drives | map(attribute='uuid') | list %}
{% set root_uuids = ansible_facts['mounts'] | selectattr('mount', 'in', ['/', '/boot', '/boot/efi', '/boot/firmware'])
   | map(attribute='uuid') | reject('equalto', 'N/A') | list %}
{% set skipped_uuids = drive_uuids + root_uuids %}
{% set skipped = skipped_uuids | map('upper') | list + skipped_uuids | map('lower') | list %}
ACTION=="add|change", SUBSYSTEM=="block", ENV{ID_USB_INTERFACES}=="?*", ENV{ID_FS_USAGE}=="filesystem", ENV{ID_FS_UUID}!="{{ skipped | unique(case_sensitive=true) | sort(case_sensitive=true) | join('|') }}", RUN{program}+="/usr/bin/systemd-mount --no-block --collect --fsck={{ 'yes' if usb_automount_writable | bool else 'no' }} -o nosuid,nodev,noexec{{ '' if usb_automount_writable | bool else ',ro' }} $devnode"
