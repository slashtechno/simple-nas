# Ansible-managed. Triggered by 99-nas-drive-remount.rules whenever a block
# device reappears — re-mounts any fstab entry that isn't currently mounted
# (e.g. a backup drive that dropped offline and came back). No-op otherwise.
[Unit]
Description=Remount NAS data drives if they reappear after dropping offline

[Service]
Type=oneshot
ExecStart=/bin/mount -a
