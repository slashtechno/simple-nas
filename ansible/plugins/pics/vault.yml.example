---
# The secrets pics needs, in the host's vault (host_vars/<host>/vault.yml). `just setup <host>` fills the random ones.

# Only for pics_sso_enabled: the Tinyauth user names that may open pics, each a full owner. A host's vars.yml can read it
# (service_users: {pics: "{{ vault_pics_users }}"}) to keep user names out of the tracked file.
vault_pics_users: [yourusername]
# pics' password for its Copyparty login: also add an entry to vault_copyparty_accounts with `user: "pics"` and
# `pass: "{{ vault_pics_copyparty_password }}"`.
vault_pics_copyparty_password: "change-me-generate-with-openssl-rand-base64-32"
# Read-only token pics uses to clone its private GitHub repo onto the host (roles/git_clone/tasks/main.yml).
# Create a fine-grained token at https://github.com/settings/personal-access-tokens/new: repository access
# "Only select repositories" (just the one you need), permission Contents: Read-only, and nothing else.
# It expires after at most a year; set a reminder to renew it.
vault_pics_repo_token: "github_pat_..."
# The owner login (12+ characters).
vault_pics_password: "change-me-12-characters-minimum"
# Signs pics' share links.
vault_pics_secret_key: "change-me-generate-with-openssl-rand-base64-48"
# Only used if pics_sso_enabled is true: the client secret Tinyauth checks for pics' OpenID Connect login.
vault_pics_oidc_secret: "change-me-generate-with-openssl-rand-hex-24"
