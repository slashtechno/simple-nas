# Secrets and the local inventory (never commit these). vault.yml.example is tracked.
ansible/group_vars/*/vault.yml
ansible/host_vars/*/vault.yml
ansible/inventory/hosts.yml
.vault-pass*

# macOS and Python leftovers
.DS_Store
__pycache__/
*.py[cod]

# Agent session artifacts
.pi-subagents/

# Scratch notes and test logs (AGENTS.md)
scratch/

# Browser automation output (snapshots, console logs)
.playwright-mcp/
